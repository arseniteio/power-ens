<!-- op.acc.3 rules · Segregation of duties and tasks.
     Reserved range 107000-107099. Deployable copy of plugin-wazuh-ens/agent/rules/ensfacil_op_acc_3_json_rules.xml: if one is modified the other and the catalog `relatedRules` must be synced; plugin-wazuh-ens/tests/check-consistency.py checks it.

     They only collect FACTS, the heartbeat and the degradation: there is no CUMPLE or NO_CUMPLE rule because in this control the verdict is set by the plugin policy evaluator.

       EV-01, EV-02, EV-04, EV-05, EV-06   107001   account_action
       EV-03                               107002   critical_task_run
       EV-07                               107003   security_info_access
-->
<group name="ensfacil,op_acc_3,score,">

  <rule id="107000" level="0">
    <decoded_as>json</decoded_as>
    <field name="ensfacil">op.acc.3</field>
    <description>op.acc.3 · evento ENSFácil base</description>
  </rule>

  <!-- Level 3: a single action is not a finding, it is raw material. Higher would fill the index with every `systemctl restart` of a healthy machine. -->
  <rule id="107001" level="3">
    <if_sid>107000</if_sid>
    <field name="event">account_action</field>
    <description>op.acc.3 · acción observada: $(usuario) → $(accion)</description>
  </rule>

  <rule id="107002" level="5">
    <if_sid>107000</if_sid>
    <field name="event">critical_task_run</field>
    <description>op.acc.3 · tarea crítica ejecutada: $(tarea) por $(usuario)</description>
  </rule>

  <rule id="107003" level="5">
    <if_sid>107000</if_sid>
    <field name="event">security_info_access</field>
    <description>op.acc.3 · acceso a información de seguridad: $(usuario) sobre $(recurso)</description>
  </rule>

  <!-- The heartbeat: without a signal that the pass completed, "no incompatible functions" is indistinguishable from "did not look at the actions". -->
  <rule id="107010" level="3">
    <if_sid>107000</if_sid>
    <field name="event">collector_run</field>
    <description>op.acc.3 · pasada del recolector: $(resultado)</description>
  </rule>

  <rule id="107050" level="7">
    <if_sid>107000</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.acc.3 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

</group>
