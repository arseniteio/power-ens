<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/power_ens_op_cont_3_json_rules.xml
     Byte-identical in two places: the plugin canonical source and manager/ of the
     linux/op.cont.3 runbook (checked by plugin-wazuh-ens/tests/check-consistency.py). -->
<group name="power_ens,op_cont_3,">

  <!-- ================================================================
       op.cont.3 · Periodic tests
       Reserved range: 111700-111799
       Base 111700 · raw facts 111701-111749 · evidence_state 111750
       · collector diagnostics 111797-111799

       Everything is emitted by the MANAGER collector (agent.id=000), which reads only local
       files and uses no credentials: the two organization TSV registers in /etc/power-ens/ and,
       for each test, the alerts of alerts.json (and its daily archives) in its window. It runs
       every 6 h and re-emits EVERYTHING it says about each test: these are state facts.

       Evidence -> rule ID map (`relatedRules` in public/ens/core/evidence/catalog.ts):

         EV-01 111701 and 111702 · EV-02 111702 · EV-03 111705
         EV-04 111702, 111705 and 111706 · EV-05 111703 and 111704
         EV-06 111707 · EV-07 111704 · EV-08 111706

       EV-02, EV-04 and EV-07 have no fact of their own: the policy judges them with the others.

       No rule carries a compliance `estado`, and no description carries a long field (the
       111705 timeline, the 111707 paths): the description travels in each alert. Adding or
       moving a rule requires touching both files and the catalog together.
       ================================================================ -->

  <rule id="111700" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">op.cont.3</field>
    <description>op.cont.3 · evento Power ENS base</description>
  </rule>

  <!-- ===== First obligation: test periodically ===== -->

  <!-- EV-01. Every 6 h, one per run. How the test register
       (/etc/power-ens/continuity-test-register.tsv) was read: whether it exists, could be read,
       has the documented header and how many rows were discarded. It goes BEFORE the rows:
       without it an empty register cannot be told from an unread one. -->
  <rule id="111701" level="3">
    <if_sid>111700</if_sid>
    <field name="event">continuity_test_register_read</field>
    <description>op.cont.3 · EV-01 · registro de pruebas $(fichero): presente=$(presente), $(filas) filas válidas, $(filas_invalidas) descartadas</description>
  </rule>

  <!-- EV-01 (and EV-02, EV-04). Every 6 h, one per valid row of the test register, with what
       the collector could measure of its window. -->
  <rule id="111702" level="3">
    <if_sid>111700</if_sid>
    <field name="event">continuity_test_recorded</field>
    <description>op.cont.3 · EV-01 · prueba $(tipo) del $(inicio): $(escenario), resultado declarado $(resultado), medición $(medicion)</description>
  </rule>

  <!-- ===== Second obligation: correct what was detected ===== -->

  <!-- EV-05. Every 6 h, one per run. How the deficiency register
       (/etc/power-ens/continuity-deficiency-register.tsv) was read. -->
  <rule id="111703" level="3">
    <if_sid>111700</if_sid>
    <field name="event">continuity_deficiency_register_read</field>
    <description>op.cont.3 · EV-05 · registro de deficiencias $(fichero): presente=$(presente), $(filas) filas válidas, $(filas_invalidas) descartadas</description>
  </rule>

  <!-- EV-05 (and EV-07). Every 6 h, one per valid row of the deficiency register. The
       register `estado` column travels as `situacion`: an `estado` field is the fact verdict
       for the plugin normalizer. -->
  <rule id="111704" level="3">
    <if_sid>111700</if_sid>
    <field name="event">continuity_deficiency_recorded</field>
    <description>op.cont.3 · EV-05 · deficiencia $(deficiencia_id) de la prueba del $(prueba_inicio): $(situacion), plazo $(plazo)</description>
  </rule>

  <!-- ===== What the manager saw during each test ===== -->

  <!-- EV-03 (and EV-04). Every 6 h, one per partial test or drill with systems and per candidate
       agent of those systems: the timeline of stops (506), disconnections (504) and starts (503)
       in the window and the following 24 h. -->
  <rule id="111705" level="3">
    <if_sid>111700</if_sid>
    <field name="event">availability_event_observed</field>
    <description>op.cont.3 · EV-03 · prueba del $(prueba_inicio): $(eventos_total) eventos de disponibilidad del agente $(agente) ($(agente_id))</description>
  </rule>

  <!-- EV-08 (and EV-04). Every 6 h, one per mp.info.6 restore (rule 106606) in a test window.
       Read from the manager alerts.json, without touching mp.info.6. -->
  <rule id="111706" level="3">
    <if_sid>111700</if_sid>
    <field name="event">backup_restore_observed</field>
    <description>op.cont.3 · EV-08 · prueba del $(prueba_inicio): restauración en $(agente) ($(agente_id)) el $(instante), resultado=$(resultado)</description>
  </rule>

  <!-- EV-06. Every 6 h, one per test and agent with FIM alerts in the 24 h after the end of its
       window, aggregated. -->
  <rule id="111707" level="3">
    <if_sid>111700</if_sid>
    <field name="event">post_test_change_observed</field>
    <description>op.cont.3 · EV-06 · prueba del $(prueba_inicio): $(cambios) cambios de FIM en $(agente) ($(agente_id)) tras la ventana</description>
  </rule>

  <!-- ===== Degradation =====

       The collector issues no verdicts but must be able to say it could not look: `causa`
       distinguishes «source unreadable» (COLLECTION) from «nothing to measure against»
       (CONFIGURATION); they are fixed in different places. -->
  <rule id="111750" level="5">
    <if_sid>111700</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.cont.3 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== Collector ===== -->

  <!-- 111797. Heartbeat, at the end of each run. Proves no evidence: it says what was swept,
       which delimits in the engine the last run of each state fact. -->
  <rule id="111797" level="3">
    <if_sid>111700</if_sid>
    <field name="event">collector_run</field>
    <description>op.cont.3 · pasada del recolector ($(tipo_servidor)): $(resultado), cubre $(evidencias_cubiertas)</description>
  </rule>

  <!-- 111798. Operational warning: unreadable .env, no root, lock, a discarded register row,
       an unexpected path or log_alert_level. -->
  <rule id="111798" level="5">
    <if_sid>111700</if_sid>
    <field name="event">collector_warning</field>
    <description>op.cont.3 · aviso del recolector ($(parametro)): $(motivo)</description>
  </rule>

  <!-- 111799. The collector was stopped longer than its cron allows. -->
  <rule id="111799" level="7">
    <if_sid>111700</if_sid>
    <field name="event">collector_missing</field>
    <description>op.cont.3 · hueco en las pasadas del recolector: $(detalle)</description>
  </rule>

</group>
