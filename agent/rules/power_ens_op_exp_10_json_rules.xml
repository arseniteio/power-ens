<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/power_ens_op_exp_10_json_rules.xml
     Byte-identical in three places: the plugin canonical source and manager/ of
     the Linux and LDAP op.exp.10 runbooks (checked by
     plugin-wazuh-ens/tests/check-consistency.py). -->
<group name="power_ens,op_exp_10,">

  <!-- ================================================================
       op.exp.10 · Cryptographic key protection
       Reserved range: 111100-111199
       Base 111100 · raw facts 111101-111149 · evidence_state 111150
       · collector diagnostics 111197-111199

       Evidence -> rule ID map (`relatedRules` in dashboard/ens/core/evidence/catalog.ts):

         EV-01 111101 · EV-02 111102 · EV-03 111103 · EV-04 111104
         EV-05 111105 · EV-06 111102 · EV-07 111107 · EV-08 111102

       EV-02, EV-06 and EV-08 share ONE fact, `key_material_found`: the same private
       key found on disk, checked against the P-02 stores (EV-02), the P-01 retired
       keys (EV-06) and the P-02 declared protection (EV-08). Hence 111106 and
       111108 do not exist.

       Outside the map: 111100 (base, level 0), 111109 (raw Windows 4663 read of
       a key store), 111150 (degradation) and 111197-111199 (collector: they
       enable, they prove nothing).

       No fact carries key material: only metadata (path, format, algorithm,
       length, public-part fingerprint, mode, owner, dates). No rule carries a
       compliance `estado`; adding or moving one requires touching the three files
       and the catalog together.

       The base rule is ANCHORED (^…$) on purpose. `<field>` is an unanchored
       regular expression: `op.exp.1` also matches «op.exp.10», and the op.exp.1
       base would capture this control's events under its own rule IDs.
       ================================================================ -->

  <rule id="111100" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">^op.exp.10$</field>
    <description>op.exp.10 · evento Power ENS base</description>
  </rule>

  <!-- ===== op.exp.10.1 · Key custody during operation ===== -->

  <!-- EV-01. An access (read, write or permission change) to a key store watched
       by auditd, with its ACTOR: the session account, or the process account if
       there is no session. Aggregated per run. The actor is checked against P-08. -->
  <rule id="111101" level="5">
    <if_sid>111100</if_sid>
    <field name="event">key_material_accessed</field>
    <description>op.exp.10 · EV-01 · $(actor) accedió ($(acceso)) a material criptográfico: $(recurso)</description>
  </rule>

  <!-- EV-02, EV-06 and EV-08. A private key present on disk, with directory,
       format, algorithm, length, public fingerprint, mode and owner. A fact, not
       a finding: whether it is where it should be, retired or unprotected is
       decided by P-02 and P-01. -->
  <rule id="111102" level="3">
    <if_sid>111100</if_sid>
    <field name="event">key_material_found</field>
    <description>op.exp.10 · EV-02/EV-06/EV-08 · clave privada en $(ruta) ($(algoritmo), modo $(modo))</description>
  </rule>

  <!-- EV-07. An X.509 certificate on disk: validity, public key and signature.
       Expiry is measured against the clock in the engine; algorithm and length
       against P-03. -->
  <rule id="111107" level="3">
    <if_sid>111100</if_sid>
    <field name="event">certificate_observed</field>
    <description>op.exp.10 · EV-07 · certificado $(sujeto) en $(ruta), caduca $(caduca)</description>
  </rule>

  <!-- EV-01 (Windows). Raw trace of a read SACL on a key store: event 4663 of the
       Security channel. The judged fact is still `key_material_accessed` (111101),
       aggregated by the Windows collector; this rule keeps each read in the index. -->
  <rule id="111109" level="3">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4663$</field>
    <field name="win.eventdata.objectType">^File$</field>
    <field name="win.eventdata.objectName" type="pcre2">(?i)\\Microsoft\\Crypto\\|\\ssh_host_[a-z0-9]+_key$|\\ossec-agent\\client\.keys$|\.(?:key|pem|pfx|p12|ppk|jks|keystore)$</field>
    <options>no_full_log</options>
    <description>op.exp.10 · EV-01 · $(win.eventdata.subjectDomainName)\$(win.eventdata.subjectUserName) accedió (máscara $(win.eventdata.accessMask)) a material criptográfico: $(win.eventdata.objectName)</description>
  </rule>

  <!-- ===== op.exp.10.2 · Generation isolated from operation ===== -->

  <!-- EV-05. A key generation tool (ssh-keygen, openssl genpkey/genrsa/req
       -newkey…) run on this machine. Tool, subcommand and key type only: never
       the command line. P-05 says whether the machine is production. -->
  <rule id="111105" level="5">
    <if_sid>111100</if_sid>
    <field name="event">key_generation_tool_executed</field>
    <description>op.exp.10 · EV-05 · $(actor) generó material criptográfico con $(herramienta) $(operacion)</description>
  </rule>

  <!-- ===== op.exp.10.r1.1 · Authorized algorithms and parameters ===== -->

  <!-- EV-03. Algorithms a service ACCEPTS, per use (cipher, MAC, key exchange,
       signature, protocol, hash), with family and length. Checked against P-03. -->
  <rule id="111103" level="3">
    <if_sid>111100</if_sid>
    <field name="event">crypto_config_observed</field>
    <description>op.exp.10 · EV-03 · $(servicio) $(elemento): $(algoritmos)</description>
  </rule>

  <!-- EV-04. What is actually NEGOTIATED in the period's connections, aggregated
       by algorithm. Checked against P-03. -->
  <rule id="111104" level="3">
    <if_sid>111100</if_sid>
    <field name="event">crypto_protocol_negotiated</field>
    <description>op.exp.10 · EV-04 · $(servicio) negoció $(algoritmo) ($(uso)) $(veces) vez/veces</description>
  </rule>

  <!-- ===== Degradation =====

       `causa` distinguishes «source unreadable» from «read, nothing there»; they
       are fixed in different places. -->
  <rule id="111150" level="5">
    <if_sid>111100</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.exp.10 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== Collector ===== -->

  <!-- 111197. Heartbeat. Proves no evidence: it ENABLES them. Without it the
       silence of a sweep cannot count as compliance. -->
  <rule id="111197" level="3">
    <if_sid>111100</if_sid>
    <field name="event">collector_run</field>
    <description>op.exp.10 · pasada del recolector: $(resultado)</description>
  </rule>

  <!-- 111198. Operational warning: unreadable .env, collector without root, lock. -->
  <rule id="111198" level="5">
    <if_sid>111100</if_sid>
    <field name="event">collector_warning</field>
    <description>op.exp.10 · aviso del recolector ($(parametro)): $(motivo)</description>
  </rule>

  <!-- 111199. The collector was stopped longer than its cron allows: during that
       span there may have been accesses the audit log no longer keeps. -->
  <rule id="111199" level="7">
    <if_sid>111100</if_sid>
    <field name="event">collector_missing</field>
    <description>op.exp.10 · hueco en las pasadas del recolector: $(detalle)</description>
  </rule>

</group>
