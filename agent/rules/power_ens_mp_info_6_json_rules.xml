<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/power_ens_mp_info_6_json_rules.xml
     Byte-identical in the plugin's canonical source and in manager/ of every
     mp.info.6 runbook (checked by plugin-wazuh-ens/tests/check-consistency.py).
     Changing one requires copying the others. -->
<group name="power_ens,mp.info.6,">

  <!-- ================================================================
       mp.info.6 · Backups
       Reserved range: 106600-106799
       Base 106600 · raw facts 106601-106649 · evidence_state 106650
       · collector diagnostics 106797-106799

       Rules COMMON to every mp.info.6 runbook. The `origen` field tells which
       collector emitted the fact; the event name and the rule that supports it
       are the same for all. Each collector writes the same NDJSON line to
       /var/log/power-ens/mp_info_6.json.

       Event -> rule ID -> evidence map, as supported by `relatedRules` in
       dashboard/ens/core/evidence/catalog.ts:

         106601 backup_run        EV-01, EV-02
         106602 backup_schedule   EV-02
         106603 backup_retention  EV-03
         106604 backup_access     EV-04
         106605 backup_storage    EV-06
         106606 restore_test      EV-05
         106797 collector_run     EV-07 (heartbeat; it also enables the others)

       Outside the map: 106600 (base, level 0), 106650 (degradation: the
       collector reports it could not measure), 106798 (operational warning)
       and 106799 (gap in the collector passes).

       No rule carries a verdict in its description or group: they are facts,
       and the plugin engine decides the traffic light.
       ================================================================ -->

  <rule id="106600" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">^mp.info.6$</field>
    <description>mp.info.6 · evento Power ENS base</description>
  </rule>

  <!-- ===== mp.info.6.1 and mp.info.6.2.a · Backup run and frequency ===== -->

  <!-- EV-01 and EV-02. The last backup observed: when it ended well, when it
       ended badly, its type and destination. `resultado_ultima` tells a backup
       that never succeeded (`error` with `ultima_correcta=-`) from a machine
       not measured yet. -->
  <rule id="106601" level="3">
    <if_sid>106600</if_sid>
    <field name="event" type="pcre2">^backup_run$</field>
    <description>mp.info.6 · EV-01,EV-02 · última copia observada: $(resultado_ultima) ($(tipo))</description>
  </rule>

  <!-- EV-02. The declared or detected backup schedule: every how many hours
       and where the data comes from (real cron, `zmschedulebackup` or a
       schedule declared by the client). A commented cron line does not count
       as an active schedule: the collector decides that, not this rule. -->
  <rule id="106602" level="3">
    <if_sid>106600</if_sid>
    <field name="event" type="pcre2">^backup_schedule$</field>
    <description>mp.info.6 · EV-02 · planificación $(planificacion) ($(fuente))</description>
  </rule>

  <!-- EV-03. The configured retention: days kept and the oldest backup still
       present. -->
  <rule id="106603" level="3">
    <if_sid>106600</if_sid>
    <field name="event" type="pcre2">^backup_retention$</field>
    <description>mp.info.6 · EV-03 · retención $(retencion_dias) días, copia más antigua $(copia_mas_antigua)</description>
  </rule>

  <!-- EV-04. Who can read the backup repository: path, mode, owner, group and
       the list of accounts with read access. -->
  <rule id="106604" level="3">
    <if_sid>106600</if_sid>
    <field name="event" type="pcre2">^backup_access$</field>
    <description>mp.info.6 · EV-04 · acceso a $(ruta): modo $(modo), propietario $(propietario):$(grupo)</description>
  </rule>

  <!-- ===== mp.info.6.r2.1 · Alternative repository ===== -->

  <!-- EV-06. The backup destination: same machine or not, its type (local,
       mount, remote) and whether it is active. -->
  <rule id="106605" level="3">
    <if_sid>106600</if_sid>
    <field name="event" type="pcre2">^backup_storage$</field>
    <description>mp.info.6 · EV-06 · destino $(destino) ($(tipo)): activo=$(activo)</description>
  </rule>

  <!-- ===== mp.info.6.r1.1 · Restore test ===== -->

  <!-- EV-05. A restore test on the account or the witness file: whether the
       restore worked, whether the content matches the expected one and whether
       the later cleanup of the witness completed. A failed cleanup leaves the
       `power_ens_*` witness undeleted: the collector treats it as degradation,
       not this rule. -->
  <rule id="106606" level="3">
    <if_sid>106600</if_sid>
    <field name="event" type="pcre2">^restore_test$</field>
    <description>mp.info.6 · EV-05 · prueba de restauración $(fecha): resultado=$(resultado), limpieza=$(limpieza)</description>
  </rule>

  <!-- ===== Degradation =====

       The agent emits no verdicts, but it must be able to say it could not
       measure: `causa` tells «the source could not be read» (COLLECTION),
       «the required parameter is not configured» (CONFIGURATION) or «it was
       read and there was nothing to measure» (EVIDENCE); each is fixed in a
       different place. -->
  <rule id="106650" level="5">
    <if_sid>106600</if_sid>
    <field name="event" type="pcre2">^evidence_state$</field>
    <field name="estado" type="pcre2">^NO_EVALUABLE$</field>
    <description>mp.info.6 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== Collector ===== -->

  <!-- 106797. The heartbeat. Supports EV-07 (the collector runs and declares
       what it looked at) and enables the others: without a recent heartbeat
       the engine cannot tell «this machine is healthy and silent» from «the
       collector has been stopped for days». -->
  <rule id="106797" level="3">
    <if_sid>106600</if_sid>
    <field name="event" type="pcre2">^collector_run$</field>
    <description>mp.info.6 · pasada del recolector ($(rol)): $(resultado), cubiertas=$(evidencias_cubiertas)</description>
  </rule>

  <!-- 106798. Operational warning: unreadable .env, collector without
       permissions, misspelled parameter. No requirement or evidence: hygiene
       of the pipeline itself. -->
  <rule id="106798" level="4">
    <if_sid>106600</if_sid>
    <field name="event" type="pcre2">^collector_warning$</field>
    <description>mp.info.6 · aviso del recolector ($(parametro)): $(motivo)</description>
  </rule>

  <!-- 106799. The collector was stopped for longer than its cron allows: a
       backup or restore may have happened in that span that can no longer be
       reconstructed. -->
  <rule id="106799" level="7">
    <if_sid>106600</if_sid>
    <field name="event" type="pcre2">^collector_missing$</field>
    <description>mp.info.6 · hueco en las pasadas del recolector: $(motivo)</description>
  </rule>

</group>
