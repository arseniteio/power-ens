<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/power_ens_op_acc_5_json_rules.xml
     Deployable copy, byte-identical in the Linux and LDAP runbooks (checked by
     plugin-wazuh-ens/tests/check-consistency.py). -->
<group name="power_ens,op_acc_5,score,">

  <!-- ================================================================
       op.acc.5 · Authentication mechanism (external users)
       Reserved range: 110000-110099
       Base 110000 · raw facts 110001-110019 · inventory 110020
       Degradation 110050 · collector diagnostics 110097-110099

       Evidence -> rule ID map (`relatedRules` in dashboard/ens/core/evidence/catalog.ts):

         EV-01 110002 110011 · EV-02 110004 110005 110006 · EV-03 110003
         EV-04 110007 · EV-05 110008 · EV-06 110009 · EV-07 110001
         EV-08 110010 · EV-09 110012

       110001 carries `evidence_id=EV-07,EV-01`: one fact serving two evidences.
       Only EV-07 judges it; for EV-01 it is the retained record.

       Outside the map: 110000 (base, level 0), 110020 (listening-service
       inventory), 110050 (degradation) and 110097-110099 (collector hygiene;
       110099 is the heartbeat, read by the engine to decide whether silence
       can count as compliance).

       No rule carries a compliance `estado`: the agent emits facts, the engine
       issues the verdict. The only `estado` emitted is NO_EVALUABLE.
       The `plano` field (sistema | directorio) is emitted by the LDAP runbook only.
       ================================================================ -->

  <rule id="110000" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">op.acc.5</field>
    <description>op.acc.5 · evento Power ENS base</description>
  </rule>

  <!-- ===== op.acc.5.r1.1 · r2.1 · r3.2 · r4.2 · mechanism applied ===== -->

  <!-- EV-07 (and EV-01 record). Successful authentications of an external user,
       aggregated by service, user, origin and method. `refuerzo` is the ENS
       class of the observed factors (R1 password, R2 password+OTP, R3
       certificate+PIN, R4 card+PIN, `ninguno`); the engine checks it against P-01. -->
  <rule id="110001" level="3">
    <if_sid>110000</if_sid>
    <field name="event">external_auth_success</field>
    <description>op.acc.5 · EV-07 · $(servicio): $(usuario) autenticado con $(metodo) ($(refuerzo)) desde $(origen)</description>
  </rule>

  <!-- ===== op.acc.5.r5.1 · access log ===== -->

  <!-- EV-01. Failed authentications aggregated by service, user and origin.
       Required by R5; not judged on its own. -->
  <rule id="110002" level="3">
    <if_sid>110000</if_sid>
    <field name="event">external_auth_failure</field>
    <description>op.acc.5 · EV-01 · $(servicio): autenticación fallida de $(usuario) desde $(origen)</description>
  </rule>

  <!-- EV-01. Log source: which log is read and how many days it keeps at
       origin. Checked against P-08. -->
  <rule id="110011" level="3">
    <if_sid>110000</if_sid>
    <field name="event">access_log_source</field>
    <description>op.acc.5 · EV-01 · $(servicio): registro de accesos en $(log)</description>
  </rule>

  <!-- EV-09. Log gap: the log of a declared service disappeared or shrank
       without rotation. A finding, not a verdict; checked against P-02. -->
  <rule id="110012" level="7">
    <if_sid>110000</if_sid>
    <field name="event">access_log_gap</field>
    <description>op.acc.5 · EV-09 · $(servicio): laguna en el registro de accesos ($(tipo))</description>
  </rule>

  <!-- ===== op.acc.5.8 · attempt limit (and r1.2) ===== -->

  <!-- EV-03. Failures per origin: failed attempts and accounts targeted from
       one address. Checked against P-03. -->
  <rule id="110003" level="5">
    <if_sid>110000</if_sid>
    <field name="event">auth_failures_by_origin</field>
    <description>op.acc.5 · EV-03 · $(servicio): fallos de autenticación desde $(origen)</description>
  </rule>

  <!-- EV-02. Longest streak of consecutive failures of an account with no
       success or lockout in between. Checked against P-03. -->
  <rule id="110004" level="5">
    <if_sid>110000</if_sid>
    <field name="event">failed_attempt_streak</field>
    <description>op.acc.5 · EV-02 · $(servicio): fallos consecutivos de $(usuario)</description>
  </rule>

  <!-- EV-02. Lockout policy declared or applied by the service. -->
  <rule id="110005" level="3">
    <if_sid>110000</if_sid>
    <field name="event">lockout_policy</field>
    <description>op.acc.5 · EV-02 · $(servicio): política de bloqueo $(bloqueo), reactivación $(reactivacion)</description>
  </rule>

  <!-- EV-02. Password complexity rules of the service (r1.2). -->
  <rule id="110006" level="3">
    <if_sid>110000</if_sid>
    <field name="event">password_policy</field>
    <description>op.acc.5 · EV-02 · $(servicio): normas de complejidad $(complejidad)</description>
  </rule>

  <!-- ===== op.acc.5.4 · periodic change ===== -->

  <!-- EV-04. When the credential of an external account last changed.
       Checked against P-05. -->
  <rule id="110007" level="3">
    <if_sid>110000</if_sid>
    <field name="event">credential_age</field>
    <description>op.acc.5 · EV-04 · $(servicio): credencial de $(usuario) cambiada por última vez $(ultimo_cambio)</description>
  </rule>

  <!-- ===== op.acc.5.5 · op.acc.5.6 · disablement ===== -->

  <!-- EV-05. Time between the compromise or end-of-relationship notice and
       disablement, or the time still pending. Checked against P-06. -->
  <rule id="110008" level="5">
    <if_sid>110000</if_sid>
    <field name="event">credential_disable_delay</field>
    <description>op.acc.5 · EV-05 · $(servicio): $(usuario) ($(motivo)) inhabilitado $(inhabilitado)</description>
  </rule>

  <!-- ===== op.acc.5.7 · authentication reveals no information ===== -->

  <!-- EV-06. A rejection message that reveals information about the account
       or the system. -->
  <rule id="110009" level="7">
    <if_sid>110000</if_sid>
    <field name="event">auth_error_verbose</field>
    <description>op.acc.5 · EV-06 · $(servicio): el rechazo revela información ($(patron))</description>
  </rule>

  <!-- ===== op.acc.5.r3.1 · op.acc.5.r4.1 · certificates ===== -->

  <!-- EV-08. Certificate issuer and revocation check applied.
       Checked row by row against P-07. -->
  <rule id="110010" level="3">
    <if_sid>110000</if_sid>
    <field name="event">certificate_validation</field>
    <description>op.acc.5 · EV-08 · $(servicio): certificado de $(emisor), revocación $(revocacion)</description>
  </rule>

  <!-- ===== Inventory ===== -->

  <!-- 110020. A listening service outside loopback. Proves no evidence: shows
       which access points the machine has, to check P-02 omits none. -->
  <rule id="110020" level="3">
    <if_sid>110000</if_sid>
    <field name="event">listening_service</field>
    <description>op.acc.5 · servicio en escucha: $(proceso) en $(direccion):$(puerto)</description>
  </rule>

  <!-- ===== Degradation =====

       `causa` distinguishes «nothing declared to observe» from «source could
       not be read»; they are fixed in different places. -->
  <rule id="110050" level="7">
    <if_sid>110000</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.acc.5 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== Collector diagnostics ===== -->

  <rule id="110097" level="5">
    <if_sid>110000</if_sid>
    <field name="event">collector_warning</field>
    <description>op.acc.5 · aviso del recolector · $(parametro) · $(motivo)</description>
  </rule>

  <!-- 110098. A DECLARED source is missing: the log of a service in
       OPACC5_SERVICIOS or the directory socket. Root signal of the COLLECTION
       degradations that accompany it. -->
  <rule id="110098" level="7">
    <if_sid>110000</if_sid>
    <field name="event">collector_missing</field>
    <description>op.acc.5 · fuente declarada ausente · $(fuente) · $(motivo)</description>
  </rule>

  <!-- 110099. Heartbeat. Proves no evidence: it ENABLES them. Without it the
       silence of negative assertions cannot count as compliance. Level 3 keeps
       it in the index without noise. -->
  <rule id="110099" level="3">
    <if_sid>110000</if_sid>
    <field name="event">collector_run</field>
    <description>op.acc.5 · pasada del recolector: $(resultado)</description>
  </rule>

</group>
