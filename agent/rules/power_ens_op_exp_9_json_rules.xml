<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/power_ens_op_exp_9_json_rules.xml
     Byte-identical in three places: the plugin source and manager/ of the Linux and
     LDAP op.exp.9 runbooks. Checked by plugin-wazuh-ens/tests/check-consistency.py. -->
<group name="power_ens,op_exp_9,score,">

  <!-- ================================================================
       op.exp.9 · Incident management records
       Reserved range: 111000-111099
       Base 111000 · raw facts 111001-111049 · diagnostics 111095-111099

       The subject of the control is the MANAGER: all these facts are written by the
       manager collector (ens_opexp9_manager_collect.sh) and arrive with agent.id=000.
       It reads local files only, with no credentials: the registers the organization
       maintains in /etc/power-ens/, the alerts in /var/ossec/logs/alerts/ and the
       configuration in /var/ossec/etc/.

       Fact -> rule ID -> evidence map (`relatedRules` in
       dashboard/ens/core/evidence/catalog.ts):

         111001 incident_report_registered        EV-02, EV-09
         111002 incident_source_events_available  EV-01, EV-07
         111003 emergency_action_observed         EV-03
         111004 system_change_observed            EV-04
         111005 incident_action_registered        EV-03, EV-04, EV-08
         111006 evidence_export_sealed            EV-05, EV-06
         111007 custody_integrity_checked         EV-06
         111008 custody_access_recorded           EV-06
         111009 auditable_events_revised          EV-08
         111010 register_read                     all
         111011 alert_volume_observed             EV-02 (empty register)
         111012 alert_rule_volume_observed        EV-02 (empty register)

       Outside the map: 111000 (base, level 0), 111095 (degradation: the collector
       could NOT look), 111097 (heartbeat: enables evidence, proves none), 111098
       (operational warning) and 111099 (a source the collector needs does not exist).

       No rule carries a compliance `estado` or a `cumple`/`no_cumple` group: they are
       facts, and the plugin policy sets the verdict by correlating them by
       `incidente_id` and comparing them with the Configuration screen.
       ================================================================ -->

  <rule id="111000" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">op.exp.9</field>
    <description>op.exp.9 · evento Power ENS base</description>
  </rule>

  <!-- ===== What the organization records (TSV in /etc/power-ens) ===== -->

  <!-- EV-02 and EV-09. One row of the incident register
       (/etc/power-ens/incident-register.tsv), one per phase of each incident. The same
       register is read by op.exp.7, which emits its own fact in its band: the engine
       filters by `power_ens`, so each control needs its own. -->
  <rule id="111001" level="3">
    <if_sid>111000</if_sid>
    <field name="event">incident_report_registered</field>
    <description>op.exp.9 · EV-02 · $(incidente_id) reporte $(fase) del $(fecha) (severidad $(severidad))</description>
  </rule>

  <!-- EV-03, EV-04 and EV-08. An action the organization links to an incident
       (/etc/power-ens/incident-actions.tsv): an emergency action, a derived
       modification or a review of the auditable events. -->
  <rule id="111005" level="3">
    <if_sid>111000</if_sid>
    <field name="event">incident_action_registered</field>
    <description>op.exp.9 · EV-03 · $(incidente_id) $(tipo) registrada en $(sistema): $(objeto)</description>
  </rule>

  <!-- EV-05 and EV-06. An exported and sealed evidence the organization declares
       deposited in custody (/etc/power-ens/evidence-custody.tsv), with its SHA-256 at
       collection time. -->
  <rule id="111006" level="3">
    <if_sid>111000</if_sid>
    <field name="event">evidence_export_sealed</field>
    <description>op.exp.9 · EV-05 · $(incidente_id) evidencia $(tipo_evidencia) sellada en $(destino)</description>
  </rule>

  <!-- EV-06. An access to a custodied evidence, noted in the chain-of-custody
       register (/etc/power-ens/evidence-custody-log.tsv). -->
  <rule id="111008" level="3">
    <if_sid>111000</if_sid>
    <field name="event">custody_access_recorded</field>
    <description>op.exp.9 · EV-06 · $(usuario) accedió a $(fichero) ($(finalidad))</description>
  </rule>

  <!-- All. How each register was found on this run: whether it exists, whether it could
       be read, whether the header is the documented one and how many valid and invalid
       rows it holds. It is what separates an EMPTY register (judged) from an ABSENT one
       (nothing to judge against). -->
  <rule id="111010" level="3">
    <if_sid>111000</if_sid>
    <field name="event">register_read</field>
    <description>op.exp.9 · registro $(registro): presente=$(presente), $(filas_validas) filas válidas</description>
  </rule>

  <!-- ===== What the manager observes (alerts and configuration) ===== -->

  <!-- EV-01 and EV-07. Per incident and affected system: how many alerts of that agent
       the manager keeps in the incident window, and whether the daily alert files of that
       window are still on disk with their Wazuh chained checksum verified. -->
  <rule id="111002" level="3">
    <if_sid>111000</if_sid>
    <field name="event">incident_source_events_available</field>
    <description>op.exp.9 · EV-01 · $(incidente_id) en $(sistema): $(alertas) alertas conservadas entre $(desde) y $(hasta)</description>
  </rule>

  <!-- EV-03. A Wazuh active response (group active_response) on an affected system
       within an incident window. It is what Wazuh recorded as done; whether it is in the
       case file is decided by the engine. -->
  <rule id="111003" level="3">
    <if_sid>111000</if_sid>
    <field name="event">emergency_action_observed</field>
    <description>op.exp.9 · EV-03 · $(incidente_id) respuesta activa $(programa) en $(sistema) ($(veces) veces)</description>
  </rule>

  <!-- EV-04. An object modified on an affected system during an incident: file (FIM),
       package (dpkg/yum), configuration (op.exp.3) or account (op.acc.1), as collected by
       the manager alerts. -->
  <rule id="111004" level="3">
    <if_sid>111000</if_sid>
    <field name="event">system_change_observed</field>
    <description>op.exp.9 · EV-04 · $(incidente_id) cambio de $(origen) en $(sistema): $(objeto)</description>
  </rule>

  <!-- EV-06. Verification of the SHA-256 of a custodied evidence the manager can read,
       against the one declared when sealing it. -->
  <rule id="111007" level="3">
    <if_sid>111000</if_sid>
    <field name="event">custody_integrity_checked</field>
    <description>op.exp.9 · EV-06 · $(fichero): verificable=$(verificable), coincide=$(coincide)</description>
  </rule>

  <!-- EV-08. A modification of the manager's determination of auditable events: rules,
       decoders, ossec.conf or a group's agent.conf, with the instant it happened. -->
  <rule id="111009" level="3">
    <if_sid>111000</if_sid>
    <field name="event">auditable_events_revised</field>
    <description>op.exp.9 · EV-08 · $(fichero) modificado el $(modificado) ($(origen))</description>
  </rule>

  <!-- EV-02, only when the incident register is empty. How many non-Power ENS alerts the
       manager generated in the last 30 days, per level: it is the contrast to «zero
       incidents recorded». -->
  <rule id="111011" level="3">
    <if_sid>111000</if_sid>
    <field name="event">alert_volume_observed</field>
    <description>op.exp.9 · alertas por nivel en $(dias) días: $(por_nivel)</description>
  </rule>

  <!-- EV-02, only when the incident register is empty. The same count, per rule, from
       level 7: with their groups, so the screen can exclude families that are not
       incidents (the Vulnerability Detector, for example) without the collector deciding
       anything. -->
  <rule id="111012" level="3">
    <if_sid>111000</if_sid>
    <field name="event">alert_rule_volume_observed</field>
    <description>op.exp.9 · regla $(regla) (nivel $(nivel)): $(alertas) alertas en 30 días</description>
  </rule>

  <!-- ===== Degradation =====

       The collector issues no verdicts, but it must be able to say it could not look:
       `causa` separates «the source could not be read» from «it was read and held
       nothing»; the two are fixed in different places. -->
  <rule id="111095" level="7">
    <if_sid>111000</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.exp.9 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== Heartbeat and diagnostics ===== -->

  <!-- 111097. Proves no evidence: it ENABLES them. Without a recent heartbeat the policy
       judges nothing, because the state of the registers could be days old. -->
  <rule id="111097" level="3">
    <if_sid>111000</if_sid>
    <field name="event">collector_run</field>
    <description>op.exp.9 · pasada del recolector del manager: $(resultado)</description>
  </rule>

  <!-- 111098. Operational warning: a register row that cannot be interpreted, a
       malformed local setting. Carries no requirement or evidence: hygiene of the
       pipeline itself. -->
  <rule id="111098" level="4">
    <if_sid>111000</if_sid>
    <field name="event">collector_warning</field>
    <description>op.exp.9 · aviso del recolector: $(motivo)</description>
  </rule>

  <!-- 111099. A source the collector needs does not exist or cannot be read (the alerts
       directory, python3, jq). -->
  <rule id="111099" level="7">
    <if_sid>111000</if_sid>
    <field name="event">collector_missing</field>
    <description>op.exp.9 · falta una fuente del recolector: $(fuente) ($(motivo))</description>
  </rule>

</group>
