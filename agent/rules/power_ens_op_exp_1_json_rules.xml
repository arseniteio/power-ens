<!-- op.exp.1 · Asset inventory · manager rules.
     Canonical source: plugin-wazuh-ens/agent/rules/power_ens_op_exp_1_json_rules.xml; copied byte for byte
     into manager/ of the Linux and LDAP op.exp.1 runbooks (checked by plugin-wazuh-ens/tests/check-consistency.py). -->
<group name="power_ens,op_exp_1,">

  <!-- ================================================================
       op.exp.1 · Asset inventory
       Reserved range: 110200-110299
       Base 110200 · facts 110201-110249 · diagnostics 110295-110299

       The agent emits raw facts and no verdict (no `estado` in any rule).
       Own facts instead of Syscollector: native Wazuh inventory raises no alerts
       (rule 221, level 0) and has no rule.id, so the chain
       verdict -> evidence -> rule ID -> raw event would break.

       Evidence -> rule ID map (`relatedRules` in dashboard/ens/core/evidence/catalog.ts):
         EV-01   110201
         EV-02   110202
         EV-03   110203
         EV-04   110204
         EV-05   110205
         EV-06   110210 (review) · 110206-110209 (observed changes)
         EV-07   110201 (same fact as EV-01)

       Outside the map: 110200 (level 0, never alerts) and the diagnostics 110295-110299.

       Linux and LDAP runbooks write to the same file (/var/log/power-ens/op_exp_1.json) with the
       same rule IDs; directory hosts add the `plano` and `directorio_*` fields.
       ================================================================ -->

  <rule id="110200" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">^op.exp.1$</field>
    <description>op.exp.1 · evento Power ENS base</description>
  </rule>

  <!-- ===== Technical asset inventory ===== -->

  <!-- EV-01 and EV-07: one fact (evidence_id=EV-01,EV-07) split by the normaliser. -->
  <rule id="110201" level="3">
    <if_sid>110200</if_sid>
    <field name="event">asset_system</field>
    <description>op.exp.1 · EV-01/EV-07 · activo $(activo): $(sistema_operativo) $(version_so) sobre $(fabricante) $(modelo)</description>
  </rule>

  <!-- EV-02: software summary (manager, package count, fingerprint); changes go one by one in 110206. -->
  <rule id="110202" level="3">
    <if_sid>110200</if_sid>
    <field name="event">software_inventory</field>
    <description>op.exp.1 · EV-02 · software de $(activo): $(paquetes) paquetes ($(gestor))</description>
  </rule>

  <!-- EV-03: interfaces, addresses, listening services with process, process count. -->
  <rule id="110203" level="3">
    <if_sid>110200</if_sid>
    <field name="event">network_inventory</field>
    <description>op.exp.1 · EV-03 · red de $(activo): $(puertos_escucha) servicios en escucha</description>
  </rule>

  <!-- EV-04: agent connection state and last keepalive, read from the agent itself. -->
  <rule id="110204" level="3">
    <if_sid>110200</if_sid>
    <field name="event">agent_status</field>
    <description>op.exp.1 · EV-04 · agente de $(activo): $(estado_agente), último keepalive $(ultimo_keepalive)</description>
  </rule>

  <!-- EV-05: neighbour host from the ARP/NDP table; whether it is declared is decided against P-02 by the engine. -->
  <rule id="110205" level="3">
    <if_sid>110200</if_sid>
    <field name="event">network_host_observed</field>
    <description>op.exp.1 · EV-05 · host vecino observado desde $(activo): $(ip) ($(mac))</description>
  </rule>

  <!-- ===== Asset composition changes (EV-06): this run compared with the previous one ===== -->

  <rule id="110206" level="5">
    <if_sid>110200</if_sid>
    <field name="event">asset_software_change</field>
    <description>op.exp.1 · EV-06 · $(activo): $(cambio) de $(paquete) ($(version_anterior) → $(version_nueva))</description>
  </rule>

  <rule id="110207" level="5">
    <if_sid>110200</if_sid>
    <field name="event">asset_hardware_change</field>
    <description>op.exp.1 · EV-06 · $(activo): cambia $(atributo) ($(valor_anterior) → $(valor_nuevo))</description>
  </rule>

  <rule id="110208" level="5">
    <if_sid>110200</if_sid>
    <field name="event">asset_port_opened</field>
    <description>op.exp.1 · EV-06 · $(activo): nuevo servicio en escucha $(protocolo) $(direccion):$(puerto) ($(proceso))</description>
  </rule>

  <rule id="110209" level="3">
    <if_sid>110200</if_sid>
    <field name="event">asset_port_closed</field>
    <description>op.exp.1 · EV-06 · $(activo): deja de escuchar $(protocolo) $(direccion):$(puerto) ($(proceso))</description>
  </rule>

  <!-- EV-06: latest formal review recorded by the organisation; existential evidence, never complies by absence. -->
  <rule id="110210" level="3">
    <if_sid>110200</if_sid>
    <field name="event">inventory_review</field>
    <description>op.exp.1 · EV-06 · revisión del inventario registrada el $(fecha) ($(alcance))</description>
  </rule>

  <!-- ===== Collector diagnostics: no evidence; estado=CUMPLE/NO_CUMPLE deliberately matches 110200 (level 0). ===== -->

  <rule id="110295" level="7">
    <if_sid>110200</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.exp.1 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <rule id="110297" level="5">
    <if_sid>110200</if_sid>
    <field name="event">collector_warning</field>
    <description>op.exp.1 · aviso del recolector ($(parametro)): $(motivo)</description>
  </rule>

  <!-- Previous run older than the cron allows. -->
  <rule id="110298" level="7">
    <if_sid>110200</if_sid>
    <field name="event">collector_missing</field>
    <description>op.exp.1 · pasadas del recolector perdidas: la anterior terminó hace $(horas_desde_anterior) h</description>
  </rule>

  <!-- Heartbeat: enables EV-05 silence to count as CUMPLE (needs resultado=completada and EV-05 in `evidencias_cubiertas`). -->
  <rule id="110299" level="3">
    <if_sid>110200</if_sid>
    <field name="event">collector_run</field>
    <description>op.exp.1 · pasada del recolector: $(resultado)</description>
  </rule>

</group>
