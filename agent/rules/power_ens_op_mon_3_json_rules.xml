<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/power_ens_op_mon_3_json_rules.xml
     Byte-identical in two places: the plugin source and manager/ of the Linux
     op.mon.3 runbook. Checked by plugin-wazuh-ens/tests/check-consistency.py. -->
<group name="power_ens,op_mon_3,">

  <!-- ================================================================
       op.mon.3 · Monitoring
       Reserved range: 111400-111499
       Base 111400 · raw facts 111401-111449 · evidence_state 111450
       · collector diagnostics 111497-111499

       Two collectors, and neither uses credentials:

         - the MANAGER's (agent.id=000) runs every hour: each run emits the
           central collection state (111401); every 6 h it also emits
           everything else, re-emitted in full, including the sources its own
           logcollector reads (111402);
         - each AGENT's samples its Wazuh state files locally every hour and
           emits its sources (111402) and its connection (111403) every 6 h.

       Evidence -> rule ID map, which is what `relatedRules` vouches for in
       public/ens/core/evidence/catalog.ts:

         EV-01 111401 · EV-02 111402, 111403 y 111404
         EV-03 111405 y 111406 · EV-04 111407, 111408 y 111409
         EV-06 111410 · EV-07 111411 · EV-08 111412 (y 111406)
         EV-09 111413 · EV-10 111407 · EV-11 111408 y 111409
         EV-12 111414 · EV-13 111415

       EV-05 has no fact: it is a report datum (R3.1 is documentary).
       EV-10 and EV-11 reuse EV-04's facts.

       Each `event` is anchored (^…$), as in mp.info.6: without an anchor, a rule
       matches inside another event's name (log_source_observed inside
       syslog_source_observed) and, at the same level, the first in the file wins.
       Checked by plugin-wazuh-ens/tests/check-consistency.py.

       No rule carries a compliance `estado`, and no description carries a long
       field (111412's ids): the description travels in every alert. Adding or
       moving a rule means touching both files and the catalog at once.
       ================================================================ -->

  <rule id="111400" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">^op.mon.3$</field>
    <description>op.mon.3 · evento Power ENS base</description>
  </rule>

  <!-- ===== op.mon.3.1 · collection ===== -->

  <!-- EV-01. Every hour, on the manager. The wazuh-manager service, the analysis
       engine counters (received, processed, dropped), wazuh-remoted's, the
       <remote> connections and the active agents: the series between runs proves
       it collects and loses no events. -->
  <rule id="111401" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^event_collection_status$</field>
    <description>op.mon.3 · EV-01 · recolección: activo=$(activo), procesados $(eventos_procesados), descartados $(eventos_descartados)</description>
  </rule>

  <!-- EV-02. Every 6 h, on each agent and on the manager, one per source its
       logcollector reads (wazuh-logcollector.state): events, bytes, drops and
       the last instant its counter grew. -->
  <rule id="111402" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^log_source_observed$</field>
    <description>op.mon.3 · EV-02 · fuente $(ubicacion): $(eventos) eventos, $(descartes_periodo) descartes en el periodo, último evento $(ultimo_evento)</description>
  </rule>

  <!-- EV-02. Every 6 h, on each agent. Its connection to the manager and its
       send queue (wazuh-agentd.state). -->
  <rule id="111403" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^agent_forwarding_observed$</field>
    <description>op.mon.3 · EV-02 · envío del agente: $(conexion), último ack $(ultimo_ack)</description>
  </rule>

  <!-- EV-02. Every 6 h, on the manager. One per syslog sender (the IP in the
       location field of its alerts) with its last alert, or one with
       ubicacion=ninguna. Syslog sources only leave a trace when they alert. -->
  <rule id="111404" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^syslog_source_observed$</field>
    <description>op.mon.3 · EV-02 · emisor syslog $(ubicacion): última alerta $(ultima_alerta), $(alertas_24h) en 24 h</description>
  </rule>

  <!-- ===== op.mon.3.r1.1 · correlation ===== -->

  <!-- EV-03. Every 6 h, one per loaded rule set: rules, rules that correlate
       (frequency or if_matched_*) and MITRE ATT&CK techniques. -->
  <rule id="111405" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^correlation_rules_inventory$</field>
    <description>op.mon.3 · EV-03 · conjunto $(conjunto): $(reglas) reglas, $(reglas_correlacion) de correlación</description>
  </rule>

  <!-- EV-03 and EV-08. One action: the alerts of a correlation rule read in the
       run, aggregated per rule and day. -->
  <rule id="111406" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^correlation_alert_observed$</field>
    <description>op.mon.3 · EV-03 · correlación: regla $(regla) el $(dia), $(veces) veces</description>
  </rule>

  <!-- ===== op.mon.3.r2.1 · the exposure surface ===== -->

  <!-- EV-04 (and EV-10). Every 6 h, one per registered agent and SCA policy,
       from its database on the manager (queue/db/NNN.db). -->
  <rule id="111407" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^config_assessment_observed$</field>
    <description>op.mon.3 · EV-04 · SCA de $(agente) ($(agente_id)), política $(politica): fin $(ultimo_fin), puntuación $(puntuacion)</description>
  </rule>

  <!-- EV-04 (and EV-11). Every 6 h, one per registered agent: its connection and
       the date of its package inventory, which the vulnerability detector feeds
       on. -->
  <rule id="111408" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^package_inventory_observed$</field>
    <description>op.mon.3 · EV-04 · inventario de $(agente) ($(agente_id)) $(estado_conexion): $(inventario_ultimo)</description>
  </rule>

  <!-- EV-04 (and EV-11). Every 6 h. The vulnerability detector: enabled, its
       source's date and indexer connector errors in 24 h. -->
  <rule id="111409" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^vulnerability_detection_status$</field>
    <description>op.mon.3 · EV-04 · detector de vulnerabilidades: habilitado=$(habilitado), fuente $(feed_actualizado), $(errores_indexacion_24h) errores de indexación en 24 h</description>
  </rule>

  <!-- ===== HIGH category reinforcements ===== -->

  <!-- EV-06. Every 6 h, one per network detection system whose events the
       manager ingests (or one with producto=ninguno). -->
  <rule id="111410" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^network_detection_observed$</field>
    <description>op.mon.3 · EV-06 · detección en red $(producto) por $(fuente): última alerta $(ultima_alerta)</description>
  </rule>

  <!-- EV-07. Every 6 h, one per loaded CDB list (or one with lista=ninguna). -->
  <rule id="111411" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^ioc_list_observed$</field>
    <description>op.mon.3 · EV-07 · lista $(lista): $(entradas) entradas, del $(actualizada)</description>
  </rule>

  <!-- EV-08. Every 6 h, the ids of the loaded threshold rules (in parts if they
       do not fit on one line). -->
  <rule id="111412" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^query_volume_rules_observed$</field>
    <description>op.mon.3 · EV-08 · reglas de umbral cargadas: $(reglas_umbral) (parte $(parte) de $(partes))</description>
  </rule>

  <!-- EV-09. Every 6 h, one per channel: email and each integration. -->
  <rule id="111413" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^notification_channel_configured$</field>
    <description>op.mon.3 · EV-09 · canal $(canal): habilitado=$(habilitado), desde nivel $(nivel_minimo)</description>
  </rule>

  <!-- EV-12. Every 6 h, one per row of the inspection register (or one with
       tipo=ninguna if it is empty). -->
  <rule id="111414" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^security_inspection_recorded$</field>
    <description>op.mon.3 · EV-12 · inspección $(tipo) del $(fecha) ($(motivo))</description>
  </rule>

  <!-- EV-13. Every 6 h, one per incident of the incident register opened in the
       last 30 days (or one with incidente_id=ninguno). -->
  <rule id="111415" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^incident_registered$</field>
    <description>op.mon.3 · EV-13 · incidente $(incidente_id) del $(fecha)</description>
  </rule>

  <!-- ===== Degradation =====

       The collector emits no verdicts, but it must be able to say it could not
       look: `causa` distinguishes «the source could not be read» (COLLECTION)
       from «there is nothing to measure against» (CONFIGURATION), and the two
       are fixed in different places. -->
  <rule id="111450" level="5">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^evidence_state$</field>
    <field name="estado" type="pcre2">^NO_EVALUABLE$</field>
    <description>op.mon.3 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== The collectors ===== -->

  <!-- 111497. The heartbeat, at the end of each run that emits. It vouches for no
       evidence: it says what was swept (EV-01 in the manager's hourly run; all
       those with a fact in its 6 h run; EV-02 in an agent's), which is what
       delimits in the engine the last run of each state fact. -->
  <rule id="111497" level="3">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^collector_run$</field>
    <description>op.mon.3 · pasada del recolector ($(tipo_servidor)): $(resultado), cubre $(evidencias_cubiertas)</description>
  </rule>

  <!-- 111498. Operational warning: unreadable .env, not root, lock, a path or a
       log_alert_level different from the expected, too many sources. -->
  <rule id="111498" level="5">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^collector_warning$</field>
    <description>op.mon.3 · aviso del recolector ($(parametro)): $(motivo)</description>
  </rule>

  <!-- 111499. The collector has been stopped longer than its cron allows. -->
  <rule id="111499" level="7">
    <if_sid>111400</if_sid>
    <field name="event" type="pcre2">^collector_missing$</field>
    <description>op.mon.3 · hueco en las pasadas del recolector: $(detalle)</description>
  </rule>

</group>
