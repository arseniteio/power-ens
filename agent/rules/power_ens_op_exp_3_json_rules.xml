<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/power_ens_op_exp_3_json_rules.xml
     Byte-identical in three places: the plugin source and manager/ of the Linux
     and LDAP op.exp.3 runbooks. Checked by plugin-wazuh-ens/tests/check-consistency.py. -->
<group name="power_ens,op_exp_3,">

  <!-- ================================================================
       op.exp.3 · Security configuration management
       Reserved range: 110400-110499
       Base 110400 · raw facts 110401-110449 · evidence_state 110450
       · collector diagnostics 110497-110499

       Evidence -> rule ID map (`relatedRules` in dashboard/ens/core/evidence/catalog.ts):
         EV-02 110401 · EV-03 110402 · EV-04 110403 · EV-08 110404
         EV-09 110405 · EV-11 110406

       EV-01, EV-05, EV-06, EV-07 and EV-10 have no fact: their source is not on the
       audited machine (manager SCA results, change management system, vulnerability
       detector, incident register). The collector reports it with a NO_EVALUABLE
       evidence_state caught by 110450.

       Outside the map: 110400 (base, level 0), 110450 (degradation) and
       110497-110499 (collector: they enable, do not prove).
       No rule carries a compliance `estado`; adding or moving one requires touching
       the three files and the catalog together.
       ================================================================ -->

  <rule id="110400" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">op.exp.3</field>
    <description>op.exp.3 · evento Power ENS base</description>
  </rule>

  <!-- ===== op.exp.3.6 · Only authorized staff edits the configuration ===== -->

  <!-- EV-02. An edit of the security configuration with its ACTOR: who, on which
       file, with which operation and process, and between which instants.
       The actor is contrasted with P-03. On an LDAP server the `plano` field
       distinguishes the UNIX system from cn=config. -->
  <rule id="110401" level="5">
    <if_sid>110400</if_sid>
    <field name="event">config_file_modified</field>
    <description>op.exp.3 · EV-02 · $(actor) modificó la configuración de seguridad: $(recurso)</description>
  </rule>

  <!-- ===== op.exp.3.r1 · Regular configuration maintenance ===== -->

  <!-- EV-03. Software newly installed (not an upgrade) since the previous run.
       The package is contrasted with P-01. -->
  <rule id="110402" level="5">
    <if_sid>110400</if_sid>
    <field name="event">software_installed</field>
    <description>op.exp.3 · EV-03 · software introducido: $(paquete) $(version)</description>
  </rule>

  <!-- EV-04. A running service observed on the machine, with the profile that
       identifies it in P-02. A fact, not a finding: whether it is authorized
       is decided by that profile's row. -->
  <rule id="110403" level="3">
    <if_sid>110400</if_sid>
    <field name="event">service_running</field>
    <description>op.exp.3 · EV-04 · en ejecución en $(perfil): $(servicio)</description>
  </rule>

  <!-- EV-11. The most recent formal verification of the configuration against the
       baseline, noted by the organization. Its age is measured against P-05. -->
  <rule id="110406" level="3">
    <if_sid>110400</if_sid>
    <field name="event">baseline_verification_performed</field>
    <description>op.exp.3 · EV-11 · verificación de la configuración registrada ($(alcance))</description>
  </rule>

  <!-- ===== op.exp.3.r2.1 · Very limited number of administrators ===== -->

  <!-- EV-08. How many accounts really edited the security configuration in the
       observation window. Emitted only with the whole window observed;
       contrasted with the maximum in P-09. -->
  <rule id="110404" level="3">
    <if_sid>110400</if_sid>
    <field name="event">config_admins_observed</field>
    <description>op.exp.3 · EV-08 · administradores efectivos de la configuración: $(administradores)</description>
  </rule>

  <!-- ===== op.exp.3.r3.1 · Configuration backups ===== -->

  <!-- EV-09. The instant until which the configuration is reconstructible: the
       most recent backup of the worst-off scope. Its age is measured against P-10. -->
  <rule id="110405" level="3">
    <if_sid>110400</if_sid>
    <field name="event">config_backup_observed</field>
    <description>op.exp.3 · EV-09 · copia de la configuración reconstruible desde $(fecha)</description>
  </rule>

  <!-- ===== Degradation =====
       The `causa` distinguishes «the source could not be read» from «it was read
       and nothing was found»; they are fixed in different places. -->
  <rule id="110450" level="5">
    <if_sid>110400</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.exp.3 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== Collector ===== -->

  <!-- 110497. Heartbeat. Proves no evidence: it ENABLES it. Without it, the silence
       of EV-02 and EV-03 cannot count as compliance. -->
  <rule id="110497" level="3">
    <if_sid>110400</if_sid>
    <field name="event">collector_run</field>
    <description>op.exp.3 · pasada del recolector: $(resultado)</description>
  </rule>

  <!-- 110498. Operational warning: unreadable .env, collector without root, lock.
       Pipeline hygiene, not evidence. -->
  <rule id="110498" level="5">
    <if_sid>110400</if_sid>
    <field name="event">collector_warning</field>
    <description>op.exp.3 · aviso del recolector ($(parametro)): $(motivo)</description>
  </rule>

  <!-- 110499. The collector was stopped longer than its cron allows. Emitted by the
       next run when it sees the gap: changes may have happened that the audit
       log no longer keeps. -->
  <rule id="110499" level="7">
    <if_sid>110400</if_sid>
    <field name="event">collector_missing</field>
    <description>op.exp.3 · hueco en las pasadas del recolector: $(detalle)</description>
  </rule>

</group>
