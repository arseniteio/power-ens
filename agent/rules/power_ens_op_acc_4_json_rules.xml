<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/power_ens_op_acc_4_json_rules.xml
     Deployable copy; both must be kept in sync (checked by
     plugin-wazuh-ens/tests/check-consistency.py). -->
<group name="power_ens,op_acc_4,score,">

  <!-- ================================================================
       op.acc.4 · Access rights management process
       Reserved range: 107100-107199
       Base 107100 · raw facts 107101-107149 · evidence_state 107150-107153

       Evidence -> rule ID map (`relatedRules` in dashboard/ens/core/evidence/catalog.ts):

         EV-01 107101 · EV-02 107102 · EV-03 107103 · EV-04 107104
         EV-05 107105 · EV-06 107106 · EV-07 107107 · EV-08 107108

       Outside the map: 107100 (base, level 0) and 107110 (heartbeat: proves no
       evidence, it enables them).

       No rule carries `estado`; adding or moving one requires touching three
       places at once.
       ================================================================ -->

  <rule id="107100" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">op.acc.4</field>
    <description>op.acc.4 · evento Power ENS base</description>
  </rule>

  <!-- ===== op.acc.4.1 · All access forbidden unless expressly authorized ===== -->

  <!-- EV-01. Default-deny deviation: permissive firewall, open share or anonymous
       service. Checked against the `recurso` column of P-01. -->
  <rule id="107101" level="7">
    <if_sid>107100</if_sid>
    <field name="event">default_deny_violation</field>
    <description>op.acc.4 · EV-01 · acceso permitido sin autorización expresa: $(recurso)</description>
  </rule>

  <!-- EV-02. An observed effective privilege: who, on which resource and with
       which access. Core of the control: without the declared P-01 matrix there is
       nothing to compare against and the evidence is NO_EVALUABLE, naming it. -->
  <rule id="107102" level="3">
    <if_sid>107100</if_sid>
    <field name="event">privilege_grant</field>
    <description>op.acc.4 · EV-02 · privilegio efectivo: $(sujeto) sobre $(recurso) ($(acceso))</description>
  </rule>

  <!-- ===== op.acc.4.2 · Least privilege ===== -->

  <!-- EV-03. Observed membership of a privileged group. Its members must appear
       in the P-01 matrix. -->
  <rule id="107103" level="3">
    <if_sid>107100</if_sid>
    <field name="event">privileged_group_member</field>
    <description>op.acc.4 · EV-03 · $(usuario) pertenece al grupo privilegiado $(grupo)</description>
  </rule>

  <!-- EV-08. Privilege above the minimum: sudo without command restriction, or a
       system account with an interactive shell. A fact, not a verdict: the owner
       may have authorized it in P-01. -->
  <rule id="107108" level="7">
    <if_sid>107100</if_sid>
    <field name="event">excessive_privilege</field>
    <description>op.acc.4 · EV-08 · privilegio por encima del mínimo: $(sujeto) ($(motivo_tecnico))</description>
  </rule>

  <!-- ===== op.acc.4.3 · Need to know ===== -->

  <!-- EV-07. Access to a need-to-know resource. What is judged is whether the
       accessing profile has a justification declared in P-07, not whether the
       technical permission exists: duty versus power. -->
  <rule id="107107" level="5">
    <if_sid>107100</if_sid>
    <field name="event">sensitive_access</field>
    <description>op.acc.4 · EV-07 · acceso a recurso reservado: $(usuario) sobre $(recurso)</description>
  </rule>

  <!-- ===== op.acc.4.4 · Authorization capability ===== -->

  <!-- EV-04. A permission change with its ACTOR, checked against P-02. The field
       is `actor`, not `usuario`: who EXECUTES the change, not who it affects. -->
  <rule id="107104" level="7">
    <if_sid>107100</if_sid>
    <field name="event">permission_change</field>
    <description>op.acc.4 · EV-04 · $(actor) cambió permisos sobre $(recurso)</description>
  </rule>

  <!-- EV-05. The periodic permission review, checked against P-03. The only
       existential evidence of the control; never passes by absence. -->
  <rule id="107105" level="3">
    <if_sid>107100</if_sid>
    <field name="event">permission_review</field>
    <description>op.acc.4 · EV-05 · revisión de permisos registrada ($(alcance))</description>
  </rule>

  <!-- ===== op.acc.4.5 · Remote access policy ===== -->

  <!-- EV-06. A remote connection with channel, port, origin and account, checked
       against P-05. Everything travels in the same fact so the auditor trace reaches
       the detail without opening another event. -->
  <rule id="107106" level="5">
    <if_sid>107100</if_sid>
    <field name="event">remote_access</field>
    <description>op.acc.4 · EV-06 · acceso remoto: $(usuario) por $(canal) desde $(origen)</description>
  </rule>

  <!-- ===== Heartbeat ===== -->

  <!-- 107110. Proves no evidence: it ENABLES them. Without it the silence of the
       negative assertions above cannot count as compliance. Level 3 keeps it in the
       index without noise. -->
  <rule id="107110" level="3">
    <if_sid>107100</if_sid>
    <field name="event">collector_run</field>
    <description>op.acc.4 · pasada del recolector: $(resultado)</description>
  </rule>

  <!-- ===== Degradation =====

       `causa` distinguishes «source unreadable» from «read, nothing there»; they
       are fixed in different places. -->
  <rule id="107150" level="7">
    <if_sid>107100</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.acc.4 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

</group>
