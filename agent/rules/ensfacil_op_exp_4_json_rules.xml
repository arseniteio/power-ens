<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/ensfacil_op_exp_4_json_rules.xml
     Deployable copy so the procedure works on a server without access to the
     plugin repository. Byte-identical in the Linux runbook, the LDAP runbook and
     the plugin: checked by plugin-wazuh-ens/tests/check-consistency.py. -->
<group name="ensfacil,op_exp_4,score,">

  <!-- ================================================================
       op.exp.4 · Security maintenance and updates
       Reserved range: 110500-110599
       Base 110500 · raw facts 110501-110549 · diagnostics 110590-110599

       Fact -> rule ID -> evidence map (`relatedRules` in dashboard/ens/core/evidence/catalog.ts):

         110501 vulnerability_inventory  EV-01, EV-10
         110502 vulnerability_open       EV-02, EV-10
         110503 vulnerability_resolved   EV-02, EV-10
         110504 patch_status             EV-03
         110505 package_changed          EV-04, EV-07, EV-08, EV-09
         110506 product_support          EV-05
         110507 vendor_observed          EV-06
         110508 reversion_point_created  EV-09
         110509 firmware_version         EV-11

       Outside the map: 110500 (base, level 0), 110590 (heartbeat: enables evidence,
       does not prove it), 110591 (operational warning) and 110595 (degradation: the
       agent says it could NOT look).
       No rule carries a compliance `estado` or `cumple`/`no_cumple` in its group:
       they are facts, and the plugin engine issues the verdict.
       ================================================================ -->

  <rule id="110500" level="0">
    <decoded_as>json</decoded_as>
    <field name="ensfacil">op.exp.4</field>
    <description>op.exp.4 · evento ENSFácil base</description>
  </rule>

  <!-- ===== Vulnerabilities (Vulnerability Detector state) =====

       The three facts are written on the agent by the active-response script
       `ensfacil-opexp4-vd.sh`, with what the manager bridge reads from the
       Vulnerability Detector state index FOR THAT AGENT; hence they arrive with the
       agent's identity and not the manager's. -->

  <!-- EV-01 and EV-10. Header of a snapshot of the agent's vulnerability state: how
       many open, how many unscored and how many distinct CVSS scores. Without a
       recent header there is no continuous inventory to prove. -->
  <rule id="110501" level="3">
    <if_sid>110500</if_sid>
    <field name="event">vulnerability_inventory</field>
    <description>op.exp.4 · EV-01 · inventario de vulnerabilidades: $(abiertas) abiertas ($(instantanea))</description>
  </rule>

  <!-- EV-02 and EV-10. The OLDEST open vulnerability of each CVSS score in the
       snapshot, with the INSTANT of its detection. The engine classifies it with
       P-08, applies the P-01 deadline and measures against the clock. -->
  <rule id="110502" level="5">
    <if_sid>110500</if_sid>
    <field name="event">vulnerability_open</field>
    <description>op.exp.4 · EV-02 · $(cve) abierta desde $(detectada) (CVSS $(cvss), $(abiertas) con esa puntuación)</description>
  </rule>

  <!-- EV-02 and EV-10. A CVE that stops appearing in the agent state in two
       consecutive runs, with its detection and resolution. -->
  <rule id="110503" level="3">
    <if_sid>110500</if_sid>
    <field name="event">vulnerability_resolved</field>
    <description>op.exp.4 · EV-02 · $(cve) resuelta ($(detectada) → $(resuelta))</description>
  </rule>

  <!-- ===== Patch state and software changes (collector) ===== -->

  <!-- EV-03. Snapshot of the machine's patching: pending and security updates, since
       when, pending reboot and automatic updates. -->
  <rule id="110504" level="3">
    <if_sid>110500</if_sid>
    <field name="event">patch_status</field>
    <description>op.exp.4 · EV-03 · $(seguridad_pendientes) actualizaciones de seguridad pendientes, reinicio pendiente: $(reinicio_pendiente)</description>
  </rule>

  <!-- EV-04, EV-07, EV-08 and EV-09. An install, upgrade or removal transaction with
       its ACTOR and instant. The same fact answers four questions: who (P-02),
       when (P-04), whether it went through pre-production (P-06) and whether a
       reversion point existed (P-07). -->
  <rule id="110505" level="5">
    <if_sid>110500</if_sid>
    <field name="event">package_changed</field>
    <description>op.exp.4 · EV-04 · $(actor) cambió software ($(mecanismo), $(inicio))</description>
  </rule>

  <!-- EV-05. An installed product with the end-of-support dates the vendor itself
       publishes, when it publishes them on the machine. -->
  <rule id="110506" level="3">
    <if_sid>110500</if_sid>
    <field name="event">product_support</field>
    <description>op.exp.4 · EV-05 · $(producto) $(version) instalado</description>
  </rule>

  <!-- EV-06. A vendor or software origin present in the inventory. Contrasted with
       the `fabricante` column of P-03. -->
  <rule id="110507" level="3">
    <if_sid>110500</if_sid>
    <field name="event">vendor_observed</field>
    <description>op.exp.4 · EV-06 · software de $(fabricante) en el inventario ($(paquetes) paquetes)</description>
  </rule>

  <!-- EV-09. A local reversion point observed (LVM, ZFS, Btrfs snapshot, snapper or
       timeshift) with its creation instant. -->
  <rule id="110508" level="3">
    <if_sid>110500</if_sid>
    <field name="event">reversion_point_created</field>
    <description>op.exp.4 · EV-09 · punto de reversión $(mecanismo) $(identificador) ($(creado))</description>
  </rule>

  <!-- EV-11. Firmware version of the equipment (BIOS/UEFI). R3 is not required at
       any category. -->
  <rule id="110509" level="3">
    <if_sid>110500</if_sid>
    <field name="event">firmware_version</field>
    <description>op.exp.4 · EV-11 · firmware de $(dispositivo): $(version)</description>
  </rule>

  <!-- ===== Heartbeat ===== -->

  <!-- 110590. Proves no evidence: it ENABLES it. Without it, the silence of negative
       assertions (EV-04, EV-07) cannot count as compliance. -->
  <rule id="110590" level="3">
    <if_sid>110500</if_sid>
    <field name="event">collector_run</field>
    <description>op.exp.4 · pasada del recolector: $(resultado)</description>
  </rule>

  <!-- 110591. Operational warning from the collector or the active-response script
       (malformed local parameter, incomplete delivery). Carries no requirement or
       evidence: pipeline hygiene. -->
  <rule id="110591" level="4">
    <if_sid>110500</if_sid>
    <field name="event">collector_warning</field>
    <description>op.exp.4 · aviso del recolector: $(motivo)</description>
  </rule>

  <!-- ===== Degradation =====
       The `causa` distinguishes «the source could not be read» from «it was read
       and nothing was found»; they are fixed in different places. -->
  <rule id="110595" level="7">
    <if_sid>110500</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.exp.4 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

</group>
