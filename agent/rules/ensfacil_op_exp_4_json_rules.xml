<!-- FUENTE CANÓNICA: plugin-wazuh-ens/agent/rules/ensfacil_op_exp_4_json_rules.xml
     Esta es una copia desplegable para que el procedimiento funcione en un
     servidor sin acceso al repo del plugin. Es el MISMO fichero, byte a byte,
     en el runbook de Linux, en el de LDAP y en el plugin: lo comprueba
     plugin-wazuh-ens/tests/check-consistency.py. -->
<group name="ensfacil,op_exp_4,score,">

  <!-- ================================================================
       op.exp.4 · Mantenimiento y actualizaciones de seguridad
       Rango reservado: 110500-110599
       Base 110500 · hechos crudos 110501-110549 · diagnóstico 110590-110599

       Mapa hecho -> rule ID -> evidencia, que es lo que acredita
       `relatedRules` en dashboard/ens/core/evidence/catalog.ts:

         110501 vulnerability_inventory  EV-01, EV-10
         110502 vulnerability_open       EV-02, EV-10
         110503 vulnerability_resolved   EV-02, EV-10
         110504 patch_status             EV-03
         110505 package_changed          EV-04, EV-07, EV-08, EV-09
         110506 product_support          EV-05
         110507 vendor_observed          EV-06
         110508 reversion_point_created  EV-09
         110509 firmware_version         EV-11

       Fuera del mapa: 110500 (base, nivel 0), 110590 (el latido: no acredita
       evidencia, la habilita), 110591 (aviso operativo del recolector) y
       110595 (la degradación: el agente dice que NO pudo mirar).

       Ninguna regla lleva `estado` de cumplimiento ni `cumple`/`no_cumple` en
       su grupo: son hechos, y el veredicto lo pone el motor del plugin
       contrastándolos con la pantalla de Configuración.
       ================================================================ -->

  <rule id="110500" level="0">
    <decoded_as>json</decoded_as>
    <field name="ensfacil">op.exp.4</field>
    <description>op.exp.4 · evento ENSFácil base</description>
  </rule>

  <!-- ===== Vulnerabilidades (estado del Vulnerability Detector) =====

       Los tres hechos los escribe en el agente el script de respuesta activa
       `ensfacil-opexp4-vd.sh`, con lo que el puente del manager lee del índice
       de estados del Vulnerability Detector PARA ESE AGENTE. Por eso llegan
       con la identidad del agente y no con la del manager. -->

  <!-- EV-01 y EV-10. Cabecera de una instantánea del estado de
       vulnerabilidades del agente: cuántas abiertas, cuántas sin puntuación y
       cuántas puntuaciones CVSS distintas. Sin una cabecera reciente no hay
       inventario continuo que acreditar. -->
  <rule id="110501" level="3">
    <if_sid>110500</if_sid>
    <field name="event">vulnerability_inventory</field>
    <description>op.exp.4 · EV-01 · inventario de vulnerabilidades: $(abiertas) abiertas ($(instantanea))</description>
  </rule>

  <!-- EV-02 y EV-10. La vulnerabilidad abierta MÁS ANTIGUA de cada puntuación
       CVSS de la instantánea, con el INSTANTE de su detección. El motor la
       clasifica con P-08, le aplica el plazo de P-01 y mide contra el reloj:
       el agente no resta fechas ni conoce los plazos. -->
  <rule id="110502" level="5">
    <if_sid>110500</if_sid>
    <field name="event">vulnerability_open</field>
    <description>op.exp.4 · EV-02 · $(cve) abierta desde $(detectada) (CVSS $(cvss), $(abiertas) con esa puntuación)</description>
  </rule>

  <!-- EV-02 y EV-10. Una CVE que deja de figurar en el estado del agente en
       dos pasadas seguidas, con su detección y su resolución. -->
  <rule id="110503" level="3">
    <if_sid>110500</if_sid>
    <field name="event">vulnerability_resolved</field>
    <description>op.exp.4 · EV-02 · $(cve) resuelta ($(detectada) → $(resuelta))</description>
  </rule>

  <!-- ===== Estado de parcheado y cambios de software (recolector) ===== -->

  <!-- EV-03. Foto del parcheado de la máquina: actualizaciones pendientes y
       de seguridad, desde cuándo, reinicio pendiente y actualizaciones
       automáticas. -->
  <rule id="110504" level="3">
    <if_sid>110500</if_sid>
    <field name="event">patch_status</field>
    <description>op.exp.4 · EV-03 · $(seguridad_pendientes) actualizaciones de seguridad pendientes, reinicio pendiente: $(reinicio_pendiente)</description>
  </rule>

  <!-- EV-04, EV-07, EV-08 y EV-09. Una transacción de instalación,
       actualización o desinstalación con su ACTOR y su instante. El mismo
       hecho responde a cuatro preguntas: quién (P-02), cuándo (P-04), si pasó
       antes por preproducción (P-06) y si había punto de reversión (P-07). -->
  <rule id="110505" level="5">
    <if_sid>110500</if_sid>
    <field name="event">package_changed</field>
    <description>op.exp.4 · EV-04 · $(actor) cambió software ($(mecanismo), $(inicio))</description>
  </rule>

  <!-- EV-05. Un producto instalado con las fechas de fin de soporte que
       publica el propio fabricante, cuando las publica en la máquina. -->
  <rule id="110506" level="3">
    <if_sid>110500</if_sid>
    <field name="event">product_support</field>
    <description>op.exp.4 · EV-05 · $(producto) $(version) instalado</description>
  </rule>

  <!-- EV-06. Un fabricante u origen de software presente en el inventario. Se
       contrasta con la columna `fabricante` de P-03. -->
  <rule id="110507" level="3">
    <if_sid>110500</if_sid>
    <field name="event">vendor_observed</field>
    <description>op.exp.4 · EV-06 · software de $(fabricante) en el inventario ($(paquetes) paquetes)</description>
  </rule>

  <!-- EV-09. Un punto de reversión local observado (snapshot LVM, ZFS,
       Btrfs, snapper o timeshift) con su instante de creación. -->
  <rule id="110508" level="3">
    <if_sid>110500</if_sid>
    <field name="event">reversion_point_created</field>
    <description>op.exp.4 · EV-09 · punto de reversión $(mecanismo) $(identificador) ($(creado))</description>
  </rule>

  <!-- EV-11. Versión del firmware del equipo (BIOS/UEFI). R3 no es exigible
       en ninguna categoría. -->
  <rule id="110509" level="3">
    <if_sid>110500</if_sid>
    <field name="event">firmware_version</field>
    <description>op.exp.4 · EV-11 · firmware de $(dispositivo): $(version)</description>
  </rule>

  <!-- ===== El latido ===== -->

  <!-- 110590. No acredita ninguna evidencia: las HABILITA. Sin él, el silencio
       de las aserciones negativas (EV-04, EV-07) no puede valer como
       cumplimiento. -->
  <rule id="110590" level="3">
    <if_sid>110500</if_sid>
    <field name="event">collector_run</field>
    <description>op.exp.4 · pasada del recolector: $(resultado)</description>
  </rule>

  <!-- 110591. Aviso operativo del recolector o del script de respuesta activa
       (parámetro local mal formado, entrega incompleta). No lleva requisito
       ni evidencia: es higiene del propio pipeline. -->
  <rule id="110591" level="4">
    <if_sid>110500</if_sid>
    <field name="event">collector_warning</field>
    <description>op.exp.4 · aviso del recolector: $(motivo)</description>
  </rule>

  <!-- ===== Degradación =====

       El agente no emite veredictos, pero sí tiene que poder decir que no pudo
       mirar: la `causa` distingue «la fuente no se pudo leer» de «se leyó y no
       había nada», y las dos se arreglan en sitios distintos. -->
  <rule id="110595" level="7">
    <if_sid>110500</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.exp.4 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

</group>
