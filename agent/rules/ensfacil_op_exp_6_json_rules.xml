<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/ensfacil_op_exp_6_json_rules.xml
     Byte-identical in three places: the plugin source and manager/ of the Linux
     and LDAP op.exp.6 runbooks. Checked by plugin-wazuh-ens/tests/check-consistency.py. -->
<group name="ensfacil,op_exp_6,">

  <!-- ================================================================
       op.exp.6 · Protection against malicious code
       Reserved range: 110700-110799
       Base 110700 · raw facts 110701-110749 · evidence_state 110750
       · collector diagnostics 110797-110799

       Evidence -> rule ID map (`relatedRules` in dashboard/ens/core/evidence/catalog.ts):

         EV-01 110701 · EV-02 110702 · EV-03 110703 · EV-04 110704
         EV-05 110705 · EV-06 110706 · EV-07 110707, 110708
         EV-09 110709, 110710 · EV-10 110710 · EV-11 110710, 110711
         EV-12 110712, 110713

       110710 (`edr_capability_observed`) is one fact per capability: its
       `evidence_id` says which one it speaks of (EV-09 YARA, EV-10 rootcheck, EV-11
       active response).

       EV-08 has no fact: the VirusTotal query is made by the manager and its result
       does not return to the agent. Rootcheck findings (EV-10) are not kept on the
       agent either. The collector reports it with a NO_EVALUABLE evidence_state
       caught by 110750.

       Outside the map: 110700 (base, level 0), 110750 (degradation) and
       110797-110799 (collector: they enable, do not prove).
       No rule carries a compliance `estado`; adding or moving one requires touching
       the three files and the catalog together.
       ================================================================ -->

  <rule id="110700" level="0">
    <decoded_as>json</decoded_as>
    <field name="ensfacil">op.exp.6</field>
    <description>op.exp.6 · evento ENSFácil base</description>
  </rule>

  <!-- ===== op.exp.6.1 and 6.2 · Antimalware on every machine ===== -->

  <!-- EV-01. The antimalware of one plane of the machine (the system; on a mail
       server, also the mail service's): which product, whether installed and whether
       its service runs. `producto_activo` is contrasted with the row of the machine
       and plane in P-02. -->
  <rule id="110701" level="3">
    <if_sid>110700</if_sid>
    <field name="event">antimalware_status</field>
    <description>op.exp.6 · EV-01 · antimalware del plano $(plano) en $(equipo): $(producto_activo)</description>
  </rule>

  <!-- ===== op.exp.6.4 · Up-to-date detection databases ===== -->

  <!-- EV-02. The publication instant of the antimalware signatures of one plane.
       The engine measures their age against P-03 and the clock. -->
  <rule id="110702" level="3">
    <if_sid>110700</if_sid>
    <field name="event">antimalware_signatures_updated</field>
    <description>op.exp.6 · EV-02 · firmas de $(producto) ($(plano)) publicadas el $(fecha)</description>
  </rule>

  <!-- ===== op.exp.6.5 · Configuration and real-time protection ===== -->

  <!-- EV-03. An observed antimalware setting of one plane. `valor` is contrasted
       with the row of its plane and setting in P-04. -->
  <rule id="110703" level="3">
    <if_sid>110700</if_sid>
    <field name="event">antimalware_setting</field>
    <description>op.exp.6 · EV-03 · $(ajuste)=$(valor) en el plano $(plano)</description>
  </rule>

  <!-- ===== op.exp.6.1 · Prevention and reaction ===== -->

  <!-- EV-04. An antimalware detection with the action taken. A finding about the
       machine, not a verdict of the control: how much it weighs is decided by the engine. -->
  <rule id="110704" level="10">
    <if_sid>110700</if_sid>
    <field name="event">malware_detected</field>
    <description>op.exp.6 · EV-04 · detección de $(amenaza) en $(fichero): $(accion)</description>
  </rule>

  <!-- ===== op.exp.6.r1.1 · Periodic scan ===== -->

  <!-- EV-05. The end instant of a full system scan. Measured against P-06. -->
  <rule id="110705" level="3">
    <if_sid>110700</if_sid>
    <field name="event">full_scan_completed</field>
    <description>op.exp.6 · EV-05 · escaneo completo terminado el $(fecha) ($(ficheros_escaneados) ficheros)</description>
  </rule>

  <!-- ===== op.exp.6.r2.1 · Critical functions at boot ===== -->

  <!-- EV-06. What the Wazuh agent analyzed at its last start, read from its own
       log: paths watched by FIM, boot analysis and rootcheck. Paths are contrasted with P-07. -->
  <rule id="110706" level="3">
    <if_sid>110700</if_sid>
    <field name="event">boot_integrity_check</field>
    <description>op.exp.6 · EV-06 · análisis al arranque del agente ($(arranque_agente)): FIM terminado $(fim_fin)</description>
  </rule>

  <!-- ===== op.exp.6.r3.1 · Allowlist ===== -->

  <!-- EV-07. State of the execution allowlist mechanism. -->
  <rule id="110707" level="3">
    <if_sid>110700</if_sid>
    <field name="event">execution_control_status</field>
    <description>op.exp.6 · EV-07 · lista blanca de ejecución: $(mecanismo), modo $(modo)</description>
  </rule>

  <!-- EV-07. An execution the mechanism recorded outside its list, with the decision
       it took. The path is contrasted with P-08. -->
  <rule id="110708" level="5">
    <if_sid>110700</if_sid>
    <field name="event">execution_observed</field>
    <description>op.exp.6 · EV-07 · ejecución de $(ruta) registrada por $(mecanismo): $(decision)</description>
  </rule>

  <!-- ===== op.exp.6.r4.1 · EDR capability ===== -->

  <!-- EV-09. A match of YARA rules on a file. -->
  <rule id="110709" level="10">
    <if_sid>110700</if_sid>
    <field name="event">content_rule_match</field>
    <description>op.exp.6 · EV-09 · coincidencia YARA $(regla) en $(fichero)</description>
  </rule>

  <!-- EV-09, EV-10 and EV-11. Whether an EDR capability is deployed on the machine.
       Contrasted with the row of its capability in P-09. -->
  <rule id="110710" level="3">
    <if_sid>110700</if_sid>
    <field name="event">edr_capability_observed</field>
    <description>op.exp.6 · $(evidence_id) · capacidad EDR $(capacidad) desplegada: $(desplegada)</description>
  </rule>

  <!-- EV-11. A containment active response executed on the machine. -->
  <rule id="110711" level="5">
    <if_sid>110700</if_sid>
    <field name="event">active_response_executed</field>
    <description>op.exp.6 · EV-11 · respuesta activa $(comando) $(accion)</description>
  </rule>

  <!-- ===== op.exp.6.3 · Files from external sources ===== -->

  <!-- EV-12. A file from an external source analyzed by the gateway that receives it
       (on a mail server, the amavis analysis). -->
  <rule id="110712" level="3">
    <if_sid>110700</if_sid>
    <field name="event">external_file_scanned</field>
    <description>op.exp.6 · EV-12 · fichero externo analizado por $(via): $(resultado)</description>
  </rule>

  <!-- EV-12. A removable storage device connected. Contrasted with the P-10 policy. -->
  <rule id="110713" level="5">
    <if_sid>110700</if_sid>
    <field name="event">removable_device_connected</field>
    <description>op.exp.6 · EV-12 · dispositivo extraíble conectado: $(dispositivo)</description>
  </rule>

  <!-- ===== Degradation =====
       The `causa` distinguishes «the source could not be read» from «it was read
       and nothing was found»; they are fixed in different places. -->
  <rule id="110750" level="5">
    <if_sid>110700</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.exp.6 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== Collector ===== -->

  <!-- 110797. Heartbeat. Proves no evidence: it ENABLES it. Without it, the silence
       of EV-04, EV-05, EV-07 and EV-12 cannot count. -->
  <rule id="110797" level="3">
    <if_sid>110700</if_sid>
    <field name="event">collector_run</field>
    <description>op.exp.6 · pasada del recolector: $(resultado)</description>
  </rule>

  <!-- 110798. Operational warning: unreadable .env, collector without root, lock.
       Pipeline hygiene, not evidence. -->
  <rule id="110798" level="5">
    <if_sid>110700</if_sid>
    <field name="event">collector_warning</field>
    <description>op.exp.6 · aviso del recolector ($(parametro)): $(motivo)</description>
  </rule>

  <!-- 110799. The collector was stopped longer than its cron allows. Emitted by the
       next run when it sees the gap. -->
  <rule id="110799" level="7">
    <if_sid>110700</if_sid>
    <field name="event">collector_missing</field>
    <description>op.exp.6 · hueco en las pasadas del recolector: $(detalle)</description>
  </rule>

</group>
