<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/ensfacil_op_acc_6_json_rules.xml
     Deployable copy, byte-identical in the Linux and LDAP runbooks (checked by
     plugin-wazuh-ens/tests/check-consistency.py). -->
<group name="ensfacil,op_acc_6,score,">

  <!-- ================================================================
       op.acc.6 · Authentication mechanism (organization users)
       Reserved range: 110100-110199
       Base 110100 · raw facts 110101-110149 · diagnostics 110195-110199

       Evidence -> rule ID map (`relatedRules` in dashboard/ens/core/evidence/catalog.ts):

         EV-01 110101 110102 110105   EV-02 110101 110108
         EV-03 110103 110104          EV-04 110102 110103
         EV-05 110106                 EV-06 110107
         EV-07 110101                 EV-08 110108
         EV-09 110109                 EV-10 110110
         EV-11 110111                 EV-12 110112

       One fact serves several evidences when it describes the same observation
       (`evidence_id=EV-01,EV-02,EV-07`); the plugin normalizer splits it.

       Outside the map: 110100 (base, level 0), 110195 (degradation: the agent
       could not look), 110197 (operational warning), 110198 (missing source or
       tool) and 110199 (heartbeat: proves no evidence, it enables them).

       No rule carries a compliance `estado` or `cumple`/`no_cumple` in its
       <group>: the agent observes, the engine judges. Both runbooks (Linux and
       LDAP) emit with these IDs; the `plano` field tells the surfaces apart.
       ================================================================ -->

  <rule id="110100" level="0">
    <decoded_as>json</decoded_as>
    <field name="ensfacil">op.acc.6</field>
    <description>op.acc.6 · evento ENSFácil base</description>
  </rule>

  <!-- ===== Accesses (R5, R8, R9) ===== -->

  <!-- 110101 · SUCCESSFUL authentication on an access path (sshd, console, LDAP
       bind): origin, channel, chained methods and verified factors. EV-01 uses it
       as record (op.acc.6.r5.1), EV-02 classifies the origin against P-02
       (r1.1, r2.1, r8.1), EV-07 checks the channel against P-07 (r9.2 a, d). -->
  <rule id="110101" level="3">
    <if_sid>110100</if_sid>
    <field name="event">authentication_success</field>
    <description>op.acc.6 · HECHO (EV-01, EV-02, EV-07) · acceso de $(usuario) por $(canal) desde $(origen) con $(factores) factor(es)</description>
    <group>ENS_op.acc.6,op_acc_6_r5_1,op_acc_6_r8_1,op_acc_6_r9_2,EV_01,EV_02,EV_07,hecho_crudo,authentication_success,</group>
    <info type="text">requisito=op.acc.6.r5.1,op.acc.6.r1.1,op.acc.6.r2.1,op.acc.6.r8.1,op.acc.6.r9.2 evidencia=EV-01,EV-02,EV-07 juicio=motor parametro=P-02,P-07 formato=json_line</info>
  </rule>

  <!-- 110102 · FAILED authentication aggregated per run (user, origin, channel).
       `usuario_existe` tells lockable accounts from nonexistent ones. EV-01
       (record) and EV-04 (attack pattern against P-05, correlated with 110103). -->
  <rule id="110102" level="5">
    <if_sid>110100</if_sid>
    <field name="event">authentication_failure</field>
    <description>op.acc.6 · HECHO (EV-01, EV-04) · $(fallos) fallo(s) de autenticación de $(usuario) por $(canal) desde $(origen)</description>
    <group>ENS_op.acc.6,op_acc_6_8,op_acc_6_r5_1,EV_01,EV_04,hecho_crudo,authentication_failure,</group>
    <info type="text">requisito=op.acc.6.8,op.acc.6.r5.1 evidencia=EV-01,EV-04 juicio=motor parametro=P-05 formato=json_line</info>
  </rule>

  <!-- 110103 · Observed account lockout (pam_faillock or directory). -->
  <rule id="110103" level="7">
    <if_sid>110100</if_sid>
    <field name="event">account_locked</field>
    <description>op.acc.6 · HECHO (EV-03, EV-04) · cuenta $(usuario) bloqueada por $(mecanismo)</description>
    <group>ENS_op.acc.6,op_acc_6_8,EV_03,EV_04,hecho_crudo,account_locked,</group>
    <info type="text">requisito=op.acc.6.8 evidencia=EV-03,EV-04 juicio=motor parametro=P-05 formato=json_line</info>
  </rule>

  <!-- 110104 · Attempt-limit configuration of an authentication path: whether
       there is lockout, after how many attempts, and whether it unlocks itself.
       Checked against P-05. -->
  <rule id="110104" level="3">
    <if_sid>110100</if_sid>
    <field name="event">lockout_policy_checked</field>
    <description>op.acc.6 · HECHO (EV-03) · límite de intentos en $(ruta): bloqueo=$(bloqueo)</description>
    <group>ENS_op.acc.6,op_acc_6_8,EV_03,hecho_crudo,lockout_policy_checked,</group>
    <info type="text">requisito=op.acc.6.8 evidencia=EV-03 juicio=motor parametro=P-05 formato=json_line</info>
  </rule>

  <!-- 110105 · LOG gap in an authentication source: the source does not exist,
       never yielded, or its configuration logs no successes or failures. Sweep
       finding, checked against P-03 (sources the organization declares monitored). -->
  <rule id="110105" level="7">
    <if_sid>110100</if_sid>
    <field name="event">auth_logging_gap</field>
    <description>op.acc.6 · HECHO (EV-01) · la fuente $(fuente) no registra: $(detalle)</description>
    <group>ENS_op.acc.6,op_acc_6_r5_1,EV_01,hecho_crudo,auth_logging_gap,</group>
    <info type="text">requisito=op.acc.6.r5.1 evidencia=EV-01 juicio=motor parametro=P-03 formato=json_line</info>
  </rule>

  <!-- ===== Credential lifecycle (base) ===== -->

  <!-- 110106 · Credential age (`medida=antiguedad`) or system-enforced expiry
       (`medida=caducidad_configurada`), in days. -->
  <rule id="110106" level="3">
    <if_sid>110100</if_sid>
    <field name="event">credential_age_checked</field>
    <description>op.acc.6 · HECHO (EV-05) · $(usuario) · $(credencial) · $(medida)=$(dias) días</description>
    <group>ENS_op.acc.6,op_acc_6_4,EV_05,hecho_crudo,credential_age_checked,</group>
    <info type="text">requisito=op.acc.6.4 evidencia=EV-05 juicio=motor parametro=P-04 formato=json_line</info>
  </rule>

  <!-- 110107 · Hours between a compromise or end-of-relationship notice and the
       observed credential disablement (or elapsed hours if still enabled). -->
  <rule id="110107" level="5">
    <if_sid>110100</if_sid>
    <field name="event">credential_disable_checked</field>
    <description>op.acc.6 · HECHO (EV-06) · $(usuario) · $(motivo) · inhabilitada=$(inhabilitada) tras $(horas) h</description>
    <group>ENS_op.acc.6,op_acc_6_5,op_acc_6_6,EV_06,hecho_crudo,credential_disable_checked,</group>
    <info type="text">requisito=op.acc.6.5,op.acc.6.6 evidencia=EV-06 juicio=motor parametro=P-06 formato=json_line</info>
  </rule>

  <!-- ===== Channels (R8 and R9) ===== -->

  <!-- 110108 · Listening remote-access channel: channel, addresses, encryption
       required, always started, minimum factors. EV-08 matches it to its P-07 row
       (r9.2 b, c); EV-02 checks whether an authentication channel exposed outside
       P-02 requires a second factor. -->
  <rule id="110108" level="3">
    <if_sid>110100</if_sid>
    <field name="event">remote_channel_listening</field>
    <description>op.acc.6 · HECHO (EV-02, EV-08) · canal $(canal) en escucha en $(direcciones) · cifrado=$(cifrado)</description>
    <group>ENS_op.acc.6,op_acc_6_r8_1,op_acc_6_r9_2,EV_02,EV_08,hecho_crudo,remote_channel_listening,</group>
    <info type="text">requisito=op.acc.6.r8.1,op.acc.6.r9.2 evidencia=EV-02,EV-08 juicio=motor parametro=P-02,P-07 formato=json_line</info>
  </rule>

  <!-- ===== R6 and R7 ===== -->

  <!-- 110109 · Critical-operation point where the system does NOT require
       renewed authentication (sudo NOPASSWD, !authenticate, non-expiring
       timestamp). Sweep finding against P-08. -->
  <rule id="110109" level="5">
    <if_sid>110100</if_sid>
    <field name="event">reauthentication_not_required</field>
    <description>op.acc.6 · HECHO (EV-09) · $(punto) sin reautenticación para $(sujeto) ($(motivo_tecnico))</description>
    <group>ENS_op.acc.6,op_acc_6_r6_1,EV_09,hecho_crudo,reauthentication_not_required,</group>
    <info type="text">requisito=op.acc.6.r6.1 evidencia=EV-09 juicio=motor parametro=P-08 formato=json_line</info>
  </rule>

  <!-- 110110 · Inactivity of an enabled account (`medida=inactividad`) or
       configured automatic suspension (`medida=suspension_configurada`), in days. -->
  <rule id="110110" level="3">
    <if_sid>110100</if_sid>
    <field name="event">account_inactivity_checked</field>
    <description>op.acc.6 · HECHO (EV-10) · $(usuario) · $(medida)=$(dias) días</description>
    <group>ENS_op.acc.6,op_acc_6_r7_1,EV_10,hecho_crudo,account_inactivity_checked,</group>
    <info type="text">requisito=op.acc.6.r7.1 evidencia=EV-10 juicio=motor parametro=P-09 formato=json_line</info>
  </rule>

  <!-- ===== R1 ===== -->

  <!-- 110111 · System-enforced password quality policy: minimum length,
       character classes, history and block list. -->
  <rule id="110111" level="3">
    <if_sid>110100</if_sid>
    <field name="event">password_policy_checked</field>
    <description>op.acc.6 · HECHO (EV-11) · política de contraseña en $(mecanismo): longitud mínima $(longitud_minima)</description>
    <group>ENS_op.acc.6,op_acc_6_r1_2,EV_11,hecho_crudo,password_policy_checked,</group>
    <info type="text">requisito=op.acc.6.r1.2 evidencia=EV-11 juicio=motor parametro=P-10 formato=json_line</info>
  </rule>

  <!-- ===== Information before authentication ===== -->

  <!-- 110112 · Information an authentication service exposes before validating
       credentials (protocol identification version, pre-login banner). Sweep
       finding against P-11. -->
  <rule id="110112" level="3">
    <if_sid>110100</if_sid>
    <field name="event">auth_disclosure_observed</field>
    <description>op.acc.6 · HECHO (EV-12) · $(servicio) expone $(exposicion)</description>
    <group>ENS_op.acc.6,op_acc_6_7,EV_12,hecho_crudo,auth_disclosure_observed,</group>
    <info type="text">requisito=op.acc.6.7 evidencia=EV-12 juicio=motor parametro=P-11 formato=json_line</info>
  </rule>

  <!-- ===== Collector diagnostics ===== -->

  <!-- 110195 · The agent issues no verdicts but must be able to say it COULD NOT
       LOOK: `causa` distinguishes «source unreadable» from «read, nothing there». -->
  <rule id="110195" level="7">
    <if_sid>110100</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.acc.6 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
    <group>ENS_op.acc.6,diagnostico,</group>
  </rule>

  <rule id="110197" level="4">
    <if_sid>110100</if_sid>
    <field name="event">collector_warning</field>
    <description>op.acc.6 · aviso del recolector ($(parametro)): $(motivo)</description>
    <group>ENS_op.acc.6,diagnostico,</group>
  </rule>

  <rule id="110198" level="7">
    <if_sid>110100</if_sid>
    <field name="event">collector_missing</field>
    <description>op.acc.6 · falta $(recurso) para $(evidencias_afectadas): $(motivo)</description>
    <group>ENS_op.acc.6,diagnostico,</group>
  </rule>

  <!-- 110199 · Heartbeat. Proves no evidence: it ENABLES them. Without it the
       silence of negative assertions cannot count as compliance. Level 3 keeps
       it in the index without noise. -->
  <rule id="110199" level="3">
    <if_sid>110100</if_sid>
    <field name="event">collector_run</field>
    <description>op.acc.6 · pasada del recolector: $(resultado)</description>
    <group>ENS_op.acc.6,diagnostico,</group>
  </rule>

</group>
