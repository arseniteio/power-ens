<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/ensfacil_op_nub_1_json_rules.xml
     Byte-identical in two places: the plugin source and manager/ of the Linux
     op.nub.1 runbook. Checked by plugin-wazuh-ens/tests/check-consistency.py. -->
<group name="ensfacil,op_nub_1,">

  <!-- ================================================================
       op.nub.1 · Cloud services protection
       Reserved range: 111500-111599
       Base 111500 · raw facts 111501-111549 · evidence_state 111550
       · collector diagnostics 111597-111599

       Everything is emitted by the MANAGER collector (agent.id=000), which reads
       local files only and uses no credentials: the configuration of Wazuh's
       cloud modules (the manager's ossec.conf and the groups' agent.conf, only
       their PRESENCE, never keys or secrets), the alerts of those modules in
       alerts.json and their errors in ossec.log. The provider's credential
       lives on a dedicated agent the customer configures. It runs every 6 h and
       re-emits the whole state.

       Evidence -> rule ID map, which is what `relatedRules` vouches for in
       public/ens/core/evidence/catalog.ts:

         EV-01 111501 · EV-02 111502 · EV-04 111503 · EV-07 111504

       EV-03 (shadow IT), EV-05 (encryption) and EV-06 (region) have no fact:
       they are report data, without a verdict (Wazuh 4.14 has no «cloud SCA»).
       EV-08 and EV-09 are documentary: the plugin judges them with the screen's
       tables.

       These rules' group does NOT carry `amazon`, `azure` or `gcp`: ENSFácil's
       facts must not be counted as cloud logs. The collector, in addition,
       discards from its counts every alert with `data.ensfacil`.

       No rule carries a compliance `estado`, and no description carries a long
       field (the lists of operations, failed controls or origins): the
       description travels in every alert. Adding or moving a rule means touching
       both files and the catalog at once.
       ================================================================ -->

  <rule id="111500" level="0">
    <decoded_as>json</decoded_as>
    <field name="ensfacil">op.nub.1</field>
    <description>op.nub.1 · evento ENSFácil base</description>
  </rule>

  <!-- ===== op.nub.1.2 · integration of the cloud services in Wazuh ===== -->

  <!-- EV-01. Every 6 h, one fact per cloud module (aws-s3, azure-logs,
       gcp-pubsub, gcp-bucket, office365, ms-graph, github), or one with
       modulo=ninguno if there is none: where it is configured, whether it is
       enabled, its last alert, those of 24 h and its errors in 24 h. -->
  <rule id="111501" level="3">
    <if_sid>111500</if_sid>
    <field name="event">cloud_integration_observed</field>
    <description>op.nub.1 · EV-01 · integración cloud $(modulo) en $(donde): última alerta $(ultima_alerta), $(alertas_24h) en 24 h, $(errores_24h) errores</description>
  </rule>

  <!-- ===== op.nub.1.r2.1 · tenant configuration ===== -->

  <!-- EV-02. Every 6 h, one fact per module, source and standard of the
       provider's own posture findings that Wazuh ingests (AWS Security Hub or
       Config, Microsoft Defender, Security Command Center), with the last
       result of each control kept between runs; or one with fuente=ninguna.
       It is not «cloud SCA»: Wazuh 4.14 does not have it. -->
  <rule id="111502" level="3">
    <if_sid>111500</if_sid>
    <field name="event">cloud_posture_finding_observed</field>
    <description>op.nub.1 · EV-02 · postura $(fuente) de $(modulo): $(controles_fallidos) de $(controles_evaluados) controles fallidos</description>
  </rule>

  <!-- ===== op.nub.1.2 · operations and logins in the cloud ===== -->

  <!-- EV-04. One action: the successful administration operations read in the
       run, aggregated per module, account and actor. Never one fact per
       operation. -->
  <rule id="111503" level="3">
    <if_sid>111500</if_sid>
    <field name="event">cloud_admin_operation_observed</field>
    <description>op.nub.1 · EV-04 · operaciones administrativas de $(actor) en $(modulo) ($(cuenta)): $(veces)</description>
  </rule>

  <!-- EV-07. One action: the interactive logins read in the run, aggregated
       per module, account, user, result and second factor. -->
  <rule id="111504" level="3">
    <if_sid>111500</if_sid>
    <field name="event">cloud_authentication_observed</field>
    <description>op.nub.1 · EV-07 · autenticación cloud de $(usuario) en $(modulo): $(resultado), segundo factor $(segundo_factor), $(veces) veces</description>
  </rule>

  <!-- ===== Degradation =====

       The collector emits no verdicts, but it must be able to say it could not
       look: `causa` distinguishes «the source could not be read» (COLLECTION)
       from «what arrived is not enough» (EVIDENCE), and the two are fixed in
       different places. -->
  <rule id="111550" level="5">
    <if_sid>111500</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.nub.1 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== The collector ===== -->

  <!-- 111597. The heartbeat, at the end of each run. It vouches for no evidence:
       it says what was swept, which is what delimits in the engine the last
       run of each state fact. -->
  <rule id="111597" level="3">
    <if_sid>111500</if_sid>
    <field name="event">collector_run</field>
    <description>op.nub.1 · pasada del recolector ($(tipo_servidor)): $(resultado), cubre $(evidencias_cubiertas)</description>
  </rule>

  <!-- 111598. Operational warning: unreadable .env, not root, lock, a path or a
       log_alert_level different from the expected, or a provider secret
       written on the manager or in a shared agent.conf. -->
  <rule id="111598" level="5">
    <if_sid>111500</if_sid>
    <field name="event">collector_warning</field>
    <description>op.nub.1 · aviso del recolector ($(parametro)): $(motivo)</description>
  </rule>

  <!-- 111599. The collector has been stopped longer than its cron allows. -->
  <rule id="111599" level="7">
    <if_sid>111500</if_sid>
    <field name="event">collector_missing</field>
    <description>op.nub.1 · hueco en las pasadas del recolector: $(detalle)</description>
  </rule>

</group>
