<!-- op.exp.2 rules · Security configuration.
     Canonical copy: agent/rules/ of the plugin. The copies in manager/ of the
     op.exp.2 runbooks must stay byte-identical. -->
<group name="ensfacil,op_exp_2,">

  <!-- ================================================================
       op.exp.2 · Security configuration
       Reserved range: 110300-110399
       Base 110300 · raw facts 110301-110349
       degradation 110350 · collector diagnostics 110390-110391

       The agent emits FACTS; the engine contrasts them with the Configuration
       screen parameters. No rule carries a compliance `estado`.

       Evidence -> rule ID map (`relatedRules` in dashboard/ens/core/evidence/catalog.ts):
         EV-01 110301 · EV-02 110302 and 110303 · EV-03 110304
         EV-04 110305 · EV-05 110306 · EV-06 110307

       EV-07 has no rule: conformity BEFORE entering operation leaves no observable fact.
       Outside the map: 110300 (base, level 0), 110350 (degradation: could not be measured),
       110390 (heartbeat: enables evidence, does not prove it), 110391 (collector warnings).
       ================================================================ -->

  <rule id="110300" level="0">
    <decoded_as>json</decoded_as>
    <field name="ensfacil">op.exp.2</field>
    <description>op.exp.2 · evento ENSFácil base</description>
  </rule>

  <!-- ===== op.exp.2.1, .2 and .3 · Baseline ===== -->

  <!-- EV-01. SCA policies the Wazuh agent actually evaluated on this machine (per
       its ossec.log) and when. Contrasted with the policy P-01 assigns to the profile. -->
  <rule id="110301" level="3">
    <if_sid>110300</if_sid>
    <field name="event">sca_evaluation</field>
    <description>op.exp.2 · EV-01 · perfil $(perfil): políticas SCA evaluadas $(politicas)</description>
  </rule>

  <!-- ===== op.exp.2.1 · Standard accounts and passwords ===== -->

  <!-- EV-02. An account that is not retired: interactive shell or usable
       credential. Contrasted with the standard accounts list P-03. -->
  <rule id="110302" level="3">
    <if_sid>110300</if_sid>
    <field name="event">login_account</field>
    <description>op.exp.2 · EV-02 · cuenta no retirada: $(usuario) ($(plano))</description>
  </rule>

  <!-- EV-02. A successful authentication. Same `usuario` field and same list P-03. -->
  <rule id="110303" level="3">
    <if_sid>110300</if_sid>
    <field name="event">account_authenticated</field>
    <description>op.exp.2 · EV-02 · autenticación con éxito: $(usuario) por $(canal)</description>
  </rule>

  <!-- ===== op.exp.2.2 · Minimum functionality ===== -->

  <!-- EV-03. An exposed function: a listening socket or a directory backend.
       Matched against the row of its profile in P-02. -->
  <rule id="110304" level="3">
    <if_sid>110300</if_sid>
    <field name="event">service_exposed</field>
    <description>op.exp.2 · EV-03 · función expuesta: $(servicio) en $(protocolo)/$(puerto) ($(exposicion))</description>
  </rule>

  <!-- ===== op.exp.2.3 · Secure defaults ===== -->

  <!-- EV-04. An insecure default value. A finding, not a verdict: it may be
       authorised as an exception in P-04. -->
  <rule id="110305" level="7">
    <if_sid>110300</if_sid>
    <field name="event">insecure_default</field>
    <description>op.exp.2 · EV-04 · valor por defecto inseguro: $(desviacion)</description>
  </rule>

  <!-- ===== op.exp.2.4 · Virtual machines ===== -->

  <!-- EV-05. The machine is virtual or hosts virtual machines. Must appear in the
       virtualization inventory P-06. -->
  <rule id="110306" level="3">
    <if_sid>110300</if_sid>
    <field name="event">virtualization_role</field>
    <description>op.exp.2 · EV-05 · $(maquina) es $(rol) ($(plataforma))</description>
  </rule>

  <!-- ===== op.exp.2.2 and .3 · Baseline evolution ===== -->

  <!-- EV-06. SCA score of a policy, read from the Wazuh API. The series in the
       window is contrasted with the threshold P-05. -->
  <rule id="110307" level="3">
    <if_sid>110300</if_sid>
    <field name="event">sca_score</field>
    <description>op.exp.2 · EV-06 · puntuación SCA $(politica): $(puntuacion)</description>
  </rule>

  <!-- ===== Degradation =====
       The `causa` distinguishes «the source could not be read» from «it was read
       and nothing was found». There is deliberately no rule for estado=CUMPLE or
       NO_CUMPLE: one would match 110300 (level 0) and never reach the index. -->
  <rule id="110350" level="7">
    <if_sid>110300</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.exp.2 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== Collector diagnostics ===== -->

  <!-- 110390. Heartbeat. Proves no evidence: it ENABLES it. Without it, the silence
       of negative assertions cannot count as compliance. -->
  <rule id="110390" level="3">
    <if_sid>110300</if_sid>
    <field name="event">collector_run</field>
    <description>op.exp.2 · pasada del recolector: $(resultado)</description>
  </rule>

  <!-- 110391. Operational warning: the collector continues but its environment is
       not as expected (no root, unreadable .env). -->
  <rule id="110391" level="5">
    <if_sid>110300</if_sid>
    <field name="event">collector_warning</field>
    <description>op.exp.2 · aviso del recolector: $(parametro) · $(motivo)</description>
  </rule>

</group>
