<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/power_ens_op_mon_1_json_rules.xml
     Byte-identical in two places: the plugin source and manager/ of the Linux
     op.mon.1 runbook. Checked by plugin-wazuh-ens/tests/check-consistency.py. -->
<group name="power_ens,op_mon_1,">

  <!-- ================================================================
       op.mon.1 · Intrusion detection
       Reserved range: 111200-111299
       Base 111200 · raw facts 111201-111249 · evidence_state 111250
       · collector diagnostics 111297-111299

       Everything is emitted by the MANAGER collector (agent.id=000), which reads
       local files only and uses no credentials. It runs every hour: each run
       emits the engine state (111201); every 6 h it also emits everything else,
       re-emitted in full.

       Evidence -> rule ID map, which is what `relatedRules` vouches for in
       public/ens/core/evidence/catalog.ts:

         EV-01 111201 and 111202 · EV-02 111203 · EV-03 111204
         EV-04 111205 · EV-05 111206 · EV-07 111207 and 111208
         EV-08 111202 and 111209

       EV-06 has no fact: it is a report datum, with no requirement judging it
       (the application of the procedures is measured by op.exp.7).

       No rule carries a compliance `estado`, and no description carries a long
       field (the 111205 ids): the description travels in every alert. Adding or
       moving a rule means touching both files and the catalog at once.
       ================================================================ -->

  <rule id="111200" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">op.mon.1</field>
    <description>op.mon.1 · evento Power ENS base</description>
  </rule>

  <!-- ===== op.mon.1.1 and op.mon.1.r1.1 · the detection engine ===== -->

  <!-- EV-01. Every hour. The wazuh-manager service and the analysis engine
       counters (wazuh-analysisd.state): the series between runs proves it
       processes. The only rule of the hourly run. -->
  <rule id="111201" level="3">
    <if_sid>111200</if_sid>
    <field name="event">detection_engine_status</field>
    <description>op.mon.1 · EV-01 · motor de detección: activo=$(activo), eventos procesados $(eventos_procesados)</description>
  </rule>

  <!-- EV-01 and EV-08. Every 6 h. The Wazuh version and the loaded ruleset:
       date of the most recent rule file, files, rules and rules with a MITRE
       ATT&CK technique. -->
  <rule id="111202" level="3">
    <if_sid>111200</if_sid>
    <field name="event">ruleset_version_observed</field>
    <description>op.mon.1 · EV-01 · ruleset de Wazuh $(version_wazuh) del $(fecha_ruleset): $(reglas) reglas</description>
  </rule>

  <!-- ===== op.mon.1.1 · coverage and result ===== -->

  <!-- EV-02. Every 6 h, one fact per registered agent. Its state in global.db
       (read-only) and the end of its last FIM, SCA and inventory scan, from its
       database on the manager. -->
  <rule id="111203" level="3">
    <if_sid>111200</if_sid>
    <field name="event">detection_coverage_observed</field>
    <description>op.mon.1 · EV-02 · agente $(agente) ($(agente_id)) $(estado_conexion): FIM $(fim_ultimo_fin), SCA $(sca_ultimo_fin)</description>
  </rule>

  <!-- EV-03. Every 6 h, one fact per registered agent. Its last own alert in
       alerts.json (without Power ENS's) and the volume of the last 24 h. Never
       one fact per alert or per rule. -->
  <rule id="111204" level="3">
    <if_sid>111200</if_sid>
    <field name="event">detection_activity_observed</field>
    <description>op.mon.1 · EV-03 · agente $(agente) ($(agente_id)): última detección $(ultima_alerta), $(alertas_24h) alertas en 24 h</description>
  </rule>

  <!-- EV-04. Every 6 h, one fact per rule set (or per part, if its ids do not
       fit on one line): the ids that can alert, as compressed ranges. -->
  <rule id="111205" level="3">
    <if_sid>111200</if_sid>
    <field name="event">ruleset_rules_loaded</field>
    <description>op.mon.1 · EV-04 · conjunto de reglas $(conjunto): $(reglas) reglas (parte $(parte) de $(partes))</description>
  </rule>

  <!-- EV-05. Every 6 h, one fact per network detection system whose events the
       manager ingests (or one with producto=ninguno if there is none). -->
  <rule id="111206" level="3">
    <if_sid>111200</if_sid>
    <field name="event">network_detection_observed</field>
    <description>op.mon.1 · EV-05 · detección en red $(producto) por $(fuente): última alerta $(ultima_alerta)</description>
  </rule>

  <!-- ===== op.mon.1.r3.1 · default actions (reported) ===== -->

  <!-- EV-07. Every 6 h. One active response configured on the manager (or one
       with comando=- if there is none). -->
  <rule id="111207" level="3">
    <if_sid>111200</if_sid>
    <field name="event">active_response_configured</field>
    <description>op.mon.1 · EV-07 · respuesta automática configurada: $(comando) sobre $(reglas_id)</description>
  </rule>

  <!-- EV-07. One action: the executions of an active response in the window,
       aggregated by agent, program and the rule that triggered it. -->
  <rule id="111208" level="5">
    <if_sid>111200</if_sid>
    <field name="event">active_response_executed</field>
    <description>op.mon.1 · EV-07 · respuesta automática $(programa) $(accion) en $(agente) por la regla $(regla_origen)</description>
  </rule>

  <!-- ===== op.mon.1.r1.1 · currency and exclusions ===== -->

  <!-- EV-08. Every 6 h. An excluded rule file (rule_exclude in ossec.conf) or a
       rule rewritten to level 0 in the custom rules (or one with tipo=ninguno
       if there is none). -->
  <rule id="111209" level="3">
    <if_sid>111200</if_sid>
    <field name="event">rule_silenced</field>
    <description>op.mon.1 · EV-08 · silenciamiento $(tipo): $(objeto) en $(fichero)</description>
  </rule>

  <!-- ===== Degradation =====

       The collector emits no verdicts, but it must be able to say it could not
       look: `causa` distinguishes «the source could not be read» (COLLECTION)
       from «there is nothing to measure against» (CONFIGURATION), and the two
       are fixed in different places. -->
  <rule id="111250" level="5">
    <if_sid>111200</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.mon.1 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== The collector ===== -->

  <!-- 111297. The heartbeat, at the end of each run. It vouches for no
       evidence: it says what was swept (EV-01 in the hourly run; all those with
       a fact in the 6 h one), which is what delimits in the engine the last run
       of each state fact. -->
  <rule id="111297" level="3">
    <if_sid>111200</if_sid>
    <field name="event">collector_run</field>
    <description>op.mon.1 · pasada del recolector ($(tipo_servidor)): $(resultado), cubre $(evidencias_cubiertas)</description>
  </rule>

  <!-- 111298. Operational warning: unreadable .env, not root, lock, a path or
       a log_alert_level different from the expected. -->
  <rule id="111298" level="5">
    <if_sid>111200</if_sid>
    <field name="event">collector_warning</field>
    <description>op.mon.1 · aviso del recolector ($(parametro)): $(motivo)</description>
  </rule>

  <!-- 111299. The collector has been stopped longer than its cron allows. -->
  <rule id="111299" level="7">
    <if_sid>111200</if_sid>
    <field name="event">collector_missing</field>
    <description>op.mon.1 · hueco en las pasadas del recolector: $(detalle)</description>
  </rule>

</group>
