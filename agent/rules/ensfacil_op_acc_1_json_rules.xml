<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/ensfacil_op_acc_1_json_rules.xml
     Deployable copy for servers without access to the plugin repository; keep both in sync. -->
<group name="ensfacil,op_acc_1,score,">

  <!-- op.acc.1 · Identification · reserved range 106800-106899
         106801-106849            events (band EXHAUSTED between this file and the Python collector ruleset)
         106850-106853            evidence_state
         106860-106863, 106869    control_state
         106870-106872, 106890    score_snapshot
         106873-106889            raw facts of migrated evidences
         106830-106831, 106891    collector diagnostics
       Check both rule files BEFORE taking an id from 106873-106889. -->

  <rule id="106800" level="0">
    <decoded_as>json</decoded_as>
    <field name="ensfacil">op.acc.1</field>
    <description>op.acc.1 · evento ENSFácil base</description>
  </rule>

  <!-- ===== op.acc.1.1 · Valid unique identifier (EV-03) ===== -->

  <!-- 106873 · RAW FACT of EV-03 and EV-05: an observed authentication, with no judgement. The plugin engine decides against P-04 and P-03.
       Level 3 and no `cumple`, `no_cumple` or `non_conformity` group: it is a technical fact, not a verdict. -->
  <rule id="106873" level="3">
    <if_sid>106800</if_sid>
    <field name="event">account_authenticated</field>
    <description>op.acc.1 · op.acc.1.1/op.acc.1.2 · HECHO (EV-03, EV-05) · Autenticación observada de $(usuario) desde $(origen)</description>
    <group>ENS_op.acc.1,op_acc_1_1,op_acc_1_2,EV_03,EV_05,nivel_bajo,nivel_medio,nivel_alto,hecho_crudo,</group>
    <info type="text">requisito=op.acc.1.1,op.acc.1.2 evidencia=EV-03,EV-05 juicio=motor parametro=P-04,P-03 formato=json_line</info>
  </rule>

  <!-- 106801 and 106802 are LEGACY since the EV-03 migration: no updated agent emits them. Kept because the index holds months of earlier alerts. Add no new events here. -->
  <rule id="106801" level="12">
    <if_sid>106800</if_sid>
    <field name="event">generic_account_login</field>
    <description>op.acc.1 · op.acc.1.1 · NO_CUMPLE (EV-03) · Autenticación con cuenta genérica o compartida</description>
    <group>ENS_op.acc.1,op_acc_1_1,EV_03,nivel_bajo,nivel_medio,nivel_alto,no_cumple,non_conformity,</group>
    <info type="text">requisito=op.acc.1.1 evidencia=EV-03 nivel=BAJO estado=NO_CUMPLE ev_id=NC-01 formato=json_line</info>
  </rule>

  <rule id="106802" level="3">
    <if_sid>106800</if_sid>
    <field name="event">auth_success</field>
    <description>op.acc.1 · op.acc.1.1 · Autenticación correcta con identificador único</description>
    <group>ENS_op.acc.1,op_acc_1_1,EV_03,nivel_bajo,nivel_medio,nivel_alto,cumple,</group>
    <info type="text">requisito=op.acc.1.1 evidencia=EV-03 nivel=BAJO estado=CUMPLE ev_id=OK-01 formato=json_line</info>
  </rule>

  <!-- ===== op.acc.1.2 · Identifiers per role (EV-05, EV-06) ===== -->

  <!-- 106805 and 106806 are LEGACY since the EV-05 migration, kept for the same reason. The plugin catalog re-admits both names as EV-05 facts: together they cover the same population as the new fact. -->
  <rule id="106805" level="12">
    <if_sid>106800</if_sid>
    <field name="event">service_account_interactive</field>
    <description>op.acc.1 · op.acc.1.2 · NO_CUMPLE (EV-05) · Cuenta de servicio usada para acceso interactivo</description>
    <group>ENS_op.acc.1,op_acc_1_2,EV_05,nivel_bajo,nivel_medio,nivel_alto,no_cumple,non_conformity,</group>
    <info type="text">requisito=op.acc.1.2 evidencia=EV-05 nivel=BAJO estado=NO_CUMPLE ev_id=NC-02 formato=json_line</info>
  </rule>

  <rule id="106806" level="3">
    <if_sid>106800</if_sid>
    <field name="event">interactive_login</field>
    <description>op.acc.1 · op.acc.1.2 · Acceso interactivo registrado</description>
    <group>ENS_op.acc.1,op_acc_1_2,EV_05,nivel_bajo,nivel_medio,nivel_alto,cumple,</group>
    <info type="text">requisito=op.acc.1.2 evidencia=EV-05 nivel=BAJO estado=CUMPLE ev_id=OK-02 formato=json_line</info>
  </rule>

  <rule id="106807" level="10">
    <if_sid>106800</if_sid>
    <field name="event">multi_role_usage</field>
    <description>op.acc.1 · op.acc.1.2 · NO_CUMPLE (EV-06) · Identificador con varios roles sin diferenciación</description>
    <group>ENS_op.acc.1,op_acc_1_2,EV_06,nivel_bajo,nivel_medio,nivel_alto,no_cumple,non_conformity,</group>
    <info type="text">requisito=op.acc.1.2 evidencia=EV-06 nivel=BAJO estado=NO_CUMPLE ev_id=NC-03 formato=json_line</info>
  </rule>

  <rule id="106808" level="3">
    <if_sid>106800</if_sid>
    <field name="event">privilege_use</field>
    <description>op.acc.1 · op.acc.1.2 · Uso de privilegios registrado</description>
    <group>ENS_op.acc.1,op_acc_1_2,EV_06,nivel_bajo,nivel_medio,nivel_alto,cumple,</group>
    <info type="text">requisito=op.acc.1.2 evidencia=EV-06 nivel=BAJO estado=CUMPLE ev_id=OK-03 formato=json_line</info>
  </rule>

  <!-- ===== op.acc.1.3 · Single identifier per entity (EV-01, EV-02) ===== -->

  <!-- The NO_CUMPLE variant takes the next lower id, precedes the general variant in the file and raises the level to win the alert. Otherwise an inventory with duplicate UIDs showed as "CUMPLE" in Wazuh. -->
  <rule id="106809" level="12">
    <if_sid>106800</if_sid>
    <field name="event">account_inventory</field>
    <field name="estado">NO_CUMPLE</field>
    <description>op.acc.1 · op.acc.1.3 · NO_CUMPLE (EV-01) · Inventario de cuentas activas con UIDs duplicados</description>
    <group>ENS_op.acc.1,op_acc_1_3,EV_01,nivel_bajo,nivel_medio,nivel_alto,no_cumple,non_conformity,</group>
    <info type="text">requisito=op.acc.1.3 evidencia=EV-01 nivel=BAJO estado=NO_CUMPLE ev_id=NC-07 formato=json_line</info>
  </rule>

  <rule id="106810" level="3">
    <if_sid>106800</if_sid>
    <field name="event">account_inventory</field>
    <description>op.acc.1 · op.acc.1.3 · CUMPLE (EV-01) · Inventario de cuentas activas recibido</description>
    <group>ENS_op.acc.1,op_acc_1_3,EV_01,nivel_bajo,nivel_medio,nivel_alto,cumple,</group>
    <info type="text">requisito=op.acc.1.3 evidencia=EV-01 nivel=BAJO estado=CUMPLE ev_id=OK-04 formato=json_line</info>
  </rule>

  <!-- RAW FACT of EV-07 besides an EV-01 event: `account_active` is an observation (UID uniqueness in EV-01, presence in P-07 in EV-07). The group keeps `cumple` because only EV-01 still uses that label. -->
  <rule id="106811" level="3">
    <if_sid>106800</if_sid>
    <field name="event">account_active</field>
    <description>op.acc.1 · op.acc.1.3/op.acc.1.r1.3 · Cuenta activa inventariada · $(usuario) (uid $(uid))</description>
    <group>ENS_op.acc.1,op_acc_1_3,op_acc_1_r1_3,EV_01,EV_07,nivel_bajo,nivel_medio,nivel_alto,cumple,hecho_crudo,</group>
    <info type="text">requisito=op.acc.1.3,op.acc.1.r1.3 evidencia=EV-01,EV-07 nivel=BAJO estado=CUMPLE ev_id=OK-05 juicio=motor parametro=P-07 formato=json_line</info>
  </rule>

  <rule id="106812" level="5">
    <if_sid>106800</if_sid>
    <field name="event">account_created</field>
    <description>op.acc.1 · op.acc.1.3 · Alta de cuenta detectada</description>
    <group>ENS_op.acc.1,op_acc_1_3,EV_02,nivel_bajo,nivel_medio,nivel_alto,</group>
    <info type="text">requisito=op.acc.1.3 evidencia=EV-02 nivel=BAJO estado=CUMPLE ev_id=OK-06 formato=json_line</info>
  </rule>

  <rule id="106813" level="5">
    <if_sid>106800</if_sid>
    <field name="event">account_modified</field>
    <description>op.acc.1 · op.acc.1.3 · Modificación de cuenta detectada</description>
    <group>ENS_op.acc.1,op_acc_1_3,EV_02,nivel_bajo,nivel_medio,nivel_alto,</group>
    <info type="text">requisito=op.acc.1.3 evidencia=EV-02 nivel=BAJO estado=CUMPLE ev_id=OK-07 formato=json_line</info>
  </rule>

  <!-- ===== op.acc.1.4 · Account lifecycle (EV-04, EV-08) ===== -->

  <rule id="106815" level="3">
    <if_sid>106800</if_sid>
    <field name="event">account_disabled</field>
    <description>op.acc.1 · op.acc.1.4 · CUMPLE (EV-04) · Cuenta deshabilitada dentro de plazo</description>
    <group>ENS_op.acc.1,op_acc_1_4,EV_04,nivel_bajo,nivel_medio,nivel_alto,cumple,</group>
    <info type="text">requisito=op.acc.1.4 evidencia=EV-04 nivel=BAJO estado=CUMPLE ev_id=OK-08 formato=json_line</info>
  </rule>

  <rule id="106816" level="12">
    <if_sid>106800</if_sid>
    <field name="event">account_offboarding</field>
    <field name="estado">NO_CUMPLE</field>
    <description>op.acc.1 · op.acc.1.4 · NO_CUMPLE (EV-04) · Cuenta de usuario dado de baja sigue habilitada fuera de plazo</description>
    <group>ENS_op.acc.1,op_acc_1_4,EV_04,nivel_bajo,nivel_medio,nivel_alto,no_cumple,non_conformity,</group>
    <info type="text">requisito=op.acc.1.4 evidencia=EV-04 nivel=BAJO estado=NO_CUMPLE ev_id=NC-04 formato=json_line</info>
  </rule>

  <rule id="106817" level="5">
    <if_sid>106800</if_sid>
    <field name="event">account_offboarding</field>
    <description>op.acc.1 · op.acc.1.4 · Baja de usuario registrada</description>
    <group>ENS_op.acc.1,op_acc_1_4,EV_04,nivel_bajo,nivel_medio,nivel_alto,</group>
    <info type="text">requisito=op.acc.1.4 evidencia=EV-04 nivel=BAJO estado=CUMPLE ev_id=OK-09 formato=json_line</info>
  </rule>

  <rule id="106818" level="5">
    <if_sid>106800</if_sid>
    <field name="event">account_deleted</field>
    <description>op.acc.1 · op.acc.1.4 · Eliminación de cuenta detectada</description>
    <group>ENS_op.acc.1,op_acc_1_4,EV_02,EV_08,nivel_bajo,nivel_medio,nivel_alto,</group>
    <info type="text">requisito=op.acc.1.4 evidencia=EV-02,EV-08 nivel=BAJO estado=CUMPLE ev_id=OK-10 formato=json_line</info>
  </rule>

  <rule id="106819" level="12">
    <if_sid>106800</if_sid>
    <field name="event">retention_violation</field>
    <description>op.acc.1 · op.acc.1.4 · NO_CUMPLE (EV-08) · Cuenta eliminada antes del periodo de retención</description>
    <group>ENS_op.acc.1,op_acc_1_4,EV_08,nivel_bajo,nivel_medio,nivel_alto,no_cumple,non_conformity,</group>
    <info type="text">requisito=op.acc.1.4 evidencia=EV-08 nivel=BAJO estado=NO_CUMPLE ev_id=NC-05 formato=json_line</info>
  </rule>

  <!-- ===== op.acc.1.r1.3 · Authorised users list (EV-07) ===== -->

  <!-- Same lower-id pattern for the NO_CUMPLE variant as 106809/106810. LEGACY since the EV-07 migration: kept for the historical index.
       Unlike 106801/106802, the catalog does NOT re-admit these names as EV-07 facts: `unauthorized_user` was emitted only for FAILING accounts and judging on that sample would give CUMPLE for the rest. -->
  <rule id="106824" level="10">
    <if_sid>106800</if_sid>
    <field name="event">authorized_list_check</field>
    <field name="estado">NO_CUMPLE</field>
    <description>op.acc.1 · op.acc.1.r1.3 · NO_CUMPLE (EV-07) · Cuentas activas no coinciden con la lista autorizada</description>
    <group>ENS_op.acc.1,op_acc_1_r1_3,EV_07,nivel_medio,nivel_alto,no_cumple,non_conformity,refuerzo_r1,</group>
    <info type="text">requisito=op.acc.1.r1.3 evidencia=EV-07 nivel=MEDIO estado=NO_CUMPLE ev_id=NC-08 formato=json_line</info>
  </rule>

  <rule id="106825" level="3">
    <if_sid>106800</if_sid>
    <field name="event">authorized_list_check</field>
    <description>op.acc.1 · op.acc.1.r1.3 · CUMPLE (EV-07) · Cuentas activas contrastadas con la lista autorizada</description>
    <group>ENS_op.acc.1,op_acc_1_r1_3,EV_07,nivel_medio,nivel_alto,cumple,refuerzo_r1,</group>
    <info type="text">requisito=op.acc.1.r1.3 evidencia=EV-07 nivel=MEDIO estado=CUMPLE ev_id=OK-11 formato=json_line</info>
  </rule>

  <rule id="106826" level="12">
    <if_sid>106800</if_sid>
    <field name="event">unauthorized_user</field>
    <description>op.acc.1 · op.acc.1.r1.3 · NO_CUMPLE (EV-07) · Cuenta activa fuera de la lista de usuarios autorizados</description>
    <group>ENS_op.acc.1,op_acc_1_r1_3,EV_07,nivel_medio,nivel_alto,no_cumple,non_conformity,refuerzo_r1,</group>
    <info type="text">requisito=op.acc.1.r1.3 evidencia=EV-07 nivel=MEDIO estado=NO_CUMPLE ev_id=NC-06 formato=json_line</info>
  </rule>

  <!-- ===== Collector diagnostics ======================
       collector_warning (106830), collector_missing (106831) and collector_run (106891) are pipeline hygiene, not ENS evidences:
       no requirement, evidence or conformity groups. 106831 is level 7 to stand out over the NO_EVALUABLE evidence_state block.
       collector_run has a rule because the engine reads it FROM THE INDEX to decide coverage. -->

  <rule id="106830" level="5">
    <if_sid>106800</if_sid>
    <field name="event">collector_warning</field>
    <description>op.acc.1 · Aviso operativo del recolector · parametro=$(parametro) · $(motivo)</description>
    <group>ENS_op.acc.1,collector_diagnostico,operativo,</group>
  </rule>

  <rule id="106831" level="7">
    <if_sid>106800</if_sid>
    <field name="event">collector_missing</field>
    <description>op.acc.1 · Latido del recolector ausente en la ventana · $(detalle)</description>
    <group>ENS_op.acc.1,collector_diagnostico,operativo,no_evaluable,disponibilidad,</group>
  </rule>

  <!-- THE HEARTBEAT. Level 3: it beats 24 times a day per agent on top of the 26 alerts of each pass; 3 is the minimum that still alerts with the default manager configuration.
       No verdict group (the SOC filters on them). Not accredited in the catalog `relatedRules`. -->
  <rule id="106891" level="3">
    <if_sid>106800</if_sid>
    <field name="event">collector_run</field>
    <description>op.acc.1 · Latido del recolector · resultado=$(resultado) · cubiertas=$(evidencias_cubiertas)</description>
    <group>ENS_op.acc.1,collector_diagnostico,operativo,latido,</group>
  </rule>

  <!-- ===== Evidence states (generic) ===== -->

  <rule id="106850" level="3">
    <if_sid>106800</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">CUMPLE</field>
    <description>op.acc.1 · Evidencia CUMPLE · $(evidence_id) · requisito=$(requisito)</description>
    <group>ENS_op.acc.1,evidence_state,cumple,</group>
  </rule>

  <rule id="106851" level="10">
    <if_sid>106800</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_CUMPLE</field>
    <description>op.acc.1 · Evidencia NO_CUMPLE · $(evidence_id) · requisito=$(requisito)</description>
    <group>ENS_op.acc.1,evidence_state,no_cumple,non_conformity,</group>
  </rule>

  <rule id="106852" level="3">
    <if_sid>106800</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.acc.1 · Evidencia NO_EVALUABLE · $(evidence_id) · requisito=$(requisito)</description>
    <group>ENS_op.acc.1,evidence_state,no_evaluable,</group>
  </rule>

  <rule id="106853" level="3">
    <if_sid>106800</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_APLICA</field>
    <description>op.acc.1 · Evidencia NO_APLICA · $(evidence_id) · requisito=$(requisito)</description>
    <group>ENS_op.acc.1,evidence_state,no_aplica,</group>
  </rule>

  <!-- ===== Control state ===== -->

  <rule id="106860" level="3">
    <if_sid>106800</if_sid>
    <field name="event">control_state</field>
    <field name="estado">CUMPLE</field>
    <description>op.acc.1 · Control CUMPLE · $(control) · nivel=$(nivel)</description>
    <group>ENS_op.acc.1,control_state,cumple,</group>
  </rule>

  <rule id="106861" level="7">
    <if_sid>106800</if_sid>
    <field name="event">control_state</field>
    <field name="estado">PARCIAL</field>
    <description>op.acc.1 · Control PARCIAL · $(control) · nivel=$(nivel)</description>
    <group>ENS_op.acc.1,control_state,parcial,</group>
  </rule>

  <rule id="106862" level="10">
    <if_sid>106800</if_sid>
    <field name="event">control_state</field>
    <field name="estado">NO_CUMPLE</field>
    <description>op.acc.1 · Control NO_CUMPLE · $(control) · nivel=$(nivel)</description>
    <group>ENS_op.acc.1,control_state,no_cumple,non_conformity,</group>
  </rule>

  <rule id="106863" level="3">
    <if_sid>106800</if_sid>
    <field name="event">control_state</field>
    <field name="estado">NO_APLICA</field>
    <description>op.acc.1 · Control NO_APLICA · $(control) · nivel=$(nivel)</description>
    <group>ENS_op.acc.1,control_state,no_aplica,</group>
  </rule>

  <!-- NO_EVALUABLE OF THE AGGREGATES (106869 and 106890). Without its own rule a NO_EVALUABLE control_state or score_snapshot fell on base 106800 (level 0) and never reached the index.
       Level 3 and no `non_conformity`: NO_EVALUABLE is not a non-conformity. Not accredited in the catalog. -->
  <rule id="106869" level="3">
    <if_sid>106800</if_sid>
    <field name="event">control_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.acc.1 · Control NO_EVALUABLE · $(control) · nivel=$(nivel)</description>
    <group>ENS_op.acc.1,control_state,no_evaluable,</group>
  </rule>

  <!-- ===== Score snapshot ===== -->

  <rule id="106870" level="3">
    <if_sid>106800</if_sid>
    <field name="event">score_snapshot</field>
    <field name="estado">CUMPLE</field>
    <description>op.acc.1 · SCORE $(nivel) CUMPLE · score=$(score) compliance=$(compliance)</description>
    <group>ENS_op.acc.1,score_snapshot,cumple,</group>
  </rule>

  <rule id="106871" level="7">
    <if_sid>106800</if_sid>
    <field name="event">score_snapshot</field>
    <field name="estado">PARCIAL</field>
    <description>op.acc.1 · SCORE $(nivel) PARCIAL · score=$(score) compliance=$(compliance)</description>
    <group>ENS_op.acc.1,score_snapshot,parcial,</group>
  </rule>

  <rule id="106872" level="10">
    <if_sid>106800</if_sid>
    <field name="event">score_snapshot</field>
    <field name="estado">NO_CUMPLE</field>
    <description>op.acc.1 · SCORE $(nivel) NO_CUMPLE · score=$(score) compliance=$(compliance)</description>
    <group>ENS_op.acc.1,score_snapshot,no_cumple,non_conformity,</group>
  </rule>

  <!-- See the 106869 comment. The description carries no `score=` or `compliance=` because a NO_EVALUABLE snapshot is published without a number; there is no rule for a NO_APLICA `score_snapshot` because it is emitted with score=0 and a rule would show "0 %" on a level that does not apply. -->
  <rule id="106890" level="3">
    <if_sid>106800</if_sid>
    <field name="event">score_snapshot</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.acc.1 · SCORE $(nivel) NO_EVALUABLE · sin_medir=$(requisitos_sin_medir) · $(motivo)</description>
    <group>ENS_op.acc.1,score_snapshot,no_evaluable,</group>
  </rule>

</group>
