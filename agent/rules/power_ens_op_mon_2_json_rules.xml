<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/power_ens_op_mon_2_json_rules.xml
     Byte-identical in two places: the plugin source and manager/ of the Linux
     op.mon.2 runbook. Checked by plugin-wazuh-ens/tests/check-consistency.py. -->
<group name="power_ens,op_mon_2,">

  <!-- ================================================================
       op.mon.2 · Metrics system
       Reserved range: 111300-111399
       Base 111300 · raw facts 111301-111349 · evidence_state 111350
       · collector diagnostics 111397-111399

       Everything is emitted by the MANAGER collector (agent.id=000), which reads
       local files only and uses no credentials. It runs every 6 h and re-emits
       the whole state: the organization's two registers in /etc/power-ens/ (the
       metrics cycle one and op.exp.7's incident one, which it only reads), the
       agent database (global.db) and the heartbeats of all Power ENS collectors,
       read from alerts.json.

       Evidence -> rule ID map, which is what `relatedRules` vouches for in
       public/ens/core/evidence/catalog.ts:

         EV-02 111301 and 111302 · EV-03 111303 and 111304
         EV-04 111305 and 111306

       EV-06 reads the same fact as EV-02 (111302: the cycle register's resource
       columns). EV-01, EV-05 and EV-07 have no fact: they are engine output and
       go to the report model, without a verdict.

       No rule carries a compliance `estado`, and no description carries a long
       field (111306's run list): the description travels in every alert. Adding
       or moving a rule means touching both files and the catalog at once.
       ================================================================ -->

  <rule id="111300" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">op.mon.2</field>
    <description>op.mon.2 · evento Power ENS base</description>
  </rule>

  <!-- ===== op.mon.2.1 and op.mon.2.r2.1 · the metrics cycle register ===== -->

  <!-- EV-02. Every 6 h. How /etc/power-ens/metrics-cycle-register.tsv was read:
       whether it exists, whether it can be read, whether its header is the
       required one and how many rows are valid. Also emitted with the register
       absent or empty: empty is judged, absent is not. -->
  <rule id="111301" level="3">
    <if_sid>111300</if_sid>
    <field name="event">metrics_register_read</field>
    <description>op.mon.2 · EV-02 · registro de ciclos de métricas: presente=$(presente), formato=$(formato), $(filas_validas) filas válidas</description>
  </rule>

  <!-- EV-02 and EV-06. Every 6 h, one fact per recorded cycle (those of the last
       400 days and always the last): period, consolidation date, degree of
       implementation, hours, budget and who validated it. -->
  <rule id="111302" level="3">
    <if_sid>111300</if_sid>
    <field name="event">metrics_cycle_recorded</field>
    <description>op.mon.2 · EV-02 · ciclo de métricas $(periodo) consolidado el $(fecha_consolidacion), validado por $(validado_por)</description>
  </rule>

  <!-- ===== op.mon.2.r1.1 · the incident register (op.exp.7's) ===== -->

  <!-- EV-03. Every 6 h. How /etc/power-ens/incident-register.tsv was read, the
       same file and the same 13-column format as op.exp.7. -->
  <rule id="111303" level="3">
    <if_sid>111300</if_sid>
    <field name="event">incident_register_read</field>
    <description>op.mon.2 · EV-03 · registro de incidentes: presente=$(presente), formato=$(formato), $(filas_validas) filas válidas</description>
  </rule>

  <!-- EV-03. Every 6 h, one fact per row (phase) of the incidents alive in the
       last 400 days, with the register's 13 columns. -->
  <rule id="111304" level="3">
    <if_sid>111300</if_sid>
    <field name="event">incident_registered</field>
    <description>op.mon.2 · EV-03 · incidente $(incidente_id), fase $(fase) del $(fecha), severidad $(severidad)</description>
  </rule>

  <!-- ===== op.mon.2.1 · measurement reliability ===== -->

  <!-- EV-04. Every 6 h, one fact per agent registered in global.db (read-only):
       connection state, last keepalive and groups. -->
  <rule id="111305" level="3">
    <if_sid>111300</if_sid>
    <field name="event">agent_keepalive_observed</field>
    <description>op.mon.2 · EV-04 · agente $(agente) ($(agente_id)) $(estado_conexion), último keepalive $(ultimo_keepalive)</description>
  </rule>

  <!-- EV-04. Every 6 h, one fact per agent: the last run of each Power ENS
       collector that has reported from it, read from the collector_run entries
       in alerts.json and kept between runs. Aggregated per agent, never one
       fact per alert or per control. -->
  <rule id="111306" level="3">
    <if_sid>111300</if_sid>
    <field name="event">collector_heartbeat_observed</field>
    <description>op.mon.2 · EV-04 · recolectores de Power ENS en $(agente) ($(agente_id)): $(recolectores) con pasada</description>
  </rule>

  <!-- ===== Degradation =====

       The collector emits no verdicts, but it must be able to say it could not
       look: `causa` distinguishes «the source could not be read» (COLLECTION)
       from «there is nothing to measure against» (CONFIGURATION), and the two
       are fixed in different places. -->
  <rule id="111350" level="5">
    <if_sid>111300</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.mon.2 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== The collector ===== -->

  <!-- 111397. The heartbeat, at the end of each run. It vouches for no evidence:
       it says what was swept, which is what delimits in the engine the last run
       of each state fact. -->
  <rule id="111397" level="3">
    <if_sid>111300</if_sid>
    <field name="event">collector_run</field>
    <description>op.mon.2 · pasada del recolector ($(tipo_servidor)): $(resultado), cubre $(evidencias_cubiertas)</description>
  </rule>

  <!-- 111398. Operational warning: unreadable .env, not root, lock, a discarded
       register row, a path or a log_alert_level different from the expected. -->
  <rule id="111398" level="5">
    <if_sid>111300</if_sid>
    <field name="event">collector_warning</field>
    <description>op.mon.2 · aviso del recolector ($(parametro)): $(motivo)</description>
  </rule>

  <!-- 111399. The collector has been stopped longer than its cron allows. -->
  <rule id="111399" level="7">
    <if_sid>111300</if_sid>
    <field name="event">collector_missing</field>
    <description>op.mon.2 · hueco en las pasadas del recolector: $(detalle)</description>
  </rule>

</group>
