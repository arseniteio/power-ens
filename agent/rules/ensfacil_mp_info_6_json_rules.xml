    <group>ENS_mp.info.6,mp_info_6_2_d,EV_03,EV_07,nivel_bajo,nivel_medio,no_cumple,non_conformity,encryption,fingerprint,</group>
    <info type="text">requisito=mp.info.6.2.d evidencia=EV-03,EV-07 nivel=MEDIO estado=NO_CUMPLE ev_id=NC-09 formato=json_line</info>
