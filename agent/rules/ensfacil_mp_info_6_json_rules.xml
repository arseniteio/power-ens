  <rule id="106650" level="3">
    <if_sid>106600</if_sid>
    <field name="event">backup_ok</field>
    <description>mp.info.6 · mp.info.6.1 · CUMPLE (EV-01) · Backup exitoso registrado</description>
    <group>ENS_mp.info.6,mp_info_6_1,EV_01,nivel_bajo,nivel_medio,cumple,</group>
    <info type="text">requisito=mp.info.6.1 evidencia=EV-01 nivel=MEDIO estado=CUMPLE ev_id=OK-01 formato=json_line</info>
  </rule>

  <rule id="106651" level="3">
    <if_sid>106600</if_sid>
    <field name="event">restore_ok</field>
    <field name="job_id" type="pcre2">^.+$</field>
    <field name="restored_path" type="pcre2">^.+$</field>
    <status type="pcre2">(?i)^(success|ok|completed|complete|cumple)$</status>
    <field name="md5" type="pcre2">^[a-fA-F0-9]{32}$</field>
    <description>mp.info.6 · mp.info.6.r1.1 · CUMPLE (EV-05) · Restore correcto con md5sum</description>
    <group>ENS_mp.info.6,mp_info_6_r1_1,EV_05,nivel_medio,cumple,restore,md5,</group>
    <info type="text">requisito=mp.info.6.r1.1 evidencia=EV-05 nivel=MEDIO estado=CUMPLE ev_id=OK-02 formato=json_line contrato=restore_validado</info>
  </rule>

  <rule id="106652" level="0">
    <if_sid>106651</if_sid>
    <field name="synthetic" type="pcre2">(?i)^(true|1|yes)$</field>
    <description>mp.info.6 · EV-05 · Evento de restauración sintético descartado</description>
    <group>ENS_mp.info.6,mp_info_6_r1_1,EV_05,no_evaluable,synthetic,suppressed,</group>
    <info type="text">requisito=mp.info.6.r1.1 evidencia=EV-05 estado=NO_EVALUABLE motivo=synthetic formato=json_line</info>
  </rule>

