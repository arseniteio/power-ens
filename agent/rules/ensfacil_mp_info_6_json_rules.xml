    <group>ENS_mp.info.6,mp_info_6_r1_1,EV_05,nivel_medio,cumple,restore,md5,</group>
    <info type="text">requisito=mp.info.6.r1.1 evidencia=EV-05 nivel=MEDIO estado=CUMPLE ev_id=OK-02 formato=json_line contrato=restore_validado</info>
  </rule>

  <rule id="106652" level="0">
    <if_sid>106651</if_sid>
    <field name="synthetic" type="pcre2">(?i)^(true|1|yes)$</field>
