<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/power_ens_op_exp_7_json_rules.xml
     Byte-identical in three places: the plugin source and manager/ of the Linux
     and LDAP op.exp.7 runbooks. Checked by plugin-wazuh-ens/tests/check-consistency.py. -->
<group name="power_ens,op_exp_7,score,">

  <!-- ================================================================
       op.exp.7 · Incident management
       Reserved range: 110800-110899
       Base 110800 · raw facts 110801-110849 · diagnostics 110895-110899

       The subject of this control is the MANAGER. Every fact is written by the
       manager's own collector (ens_opexp7_collect.sh) from local files, with no
       credentials, so they arrive with agent.id=000. A fact about another machine
       names it in its `sistema` field.

       Fact -> rule ID -> evidence map (`relatedRules` in
       dashboard/ens/core/evidence/catalog.ts):

         110801 security_alert_observed        EV-01, EV-02, EV-03
         110802 incident_registered            EV-02 to EV-08, EV-12
         110803 incident_notification_recorded EV-04, EV-07
         110804 ccn_cert_notification_recorded EV-08
         110805 improvement_action_recorded    EV-12
         110806 alert_log_seal_checked         EV-05
         110807 active_response_executed       EV-06, EV-09, EV-11
         110808 active_response_configured     EV-06, EV-09, EV-11
         110809 threat_list_observed           EV-10

       Outside the map: 110800 (base, level 0), 110895 (degradation: the collector
       could NOT look), 110897 (heartbeat: enables evidence, proves none), 110898
       (operational warning) and 110899 (missing dependency, the collector cannot run).

       No rule carries a compliance `estado` or a `cumple`/`no_cumple` group: they
       are facts, and the plugin engine sets the verdict against the Configuration screen.
       ================================================================ -->

  <rule id="110800" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">op.exp.7</field>
    <description>op.exp.7 · evento Power ENS base</description>
  </rule>

  <!-- ===== Detection (manager alerts.json) ===== -->

  <!-- EV-01, EV-02 and EV-03. Count of alerts of ONE rule and ONE level produced by
       ONE system in ONE hour, with the first and last. Aggregated because there are
       thousands per day; the level is raw and the ENS severity is set by the engine
       with P-01. Alerts of Power ENS itself (`data.power_ens` or group `power_ens`) are
       excluded: they are measurements, not security events. -->
  <rule id="110801" level="3">
    <if_sid>110800</if_sid>
    <field name="event">security_alert_observed</field>
    <description>op.exp.7 · EV-01 · $(alertas) alerta(s) de nivel $(nivel) regla $(regla) en $(sistema) ($(primera))</description>
  </rule>

  <!-- ===== Incident register (/etc/power-ens/incident-register.tsv) =====

       Maintained by the organization; the collector only READS it. Re-emitted IN FULL
       on every run (state fact): a corrected row corrects the fact on the next run. -->

  <!-- One row (one phase) of an incident: date, severity, affected systems,
       classification and personal-data assessment. -->
  <rule id="110802" level="3">
    <if_sid>110800</if_sid>
    <field name="event">incident_registered</field>
    <description>op.exp.7 · EV-02 · incidente $(incidente_id) fase $(fase) ($(severidad)) en $(sistemas)</description>
  </rule>

  <!-- EV-04 and EV-07. Who the phase was escalated to and who was notified. -->
  <rule id="110803" level="3">
    <if_sid>110800</if_sid>
    <field name="event">incident_notification_recorded</field>
    <description>op.exp.7 · EV-04 · incidente $(incidente_id): escalado a $(escalado_a), notificado a $(notificado_a)</description>
  </rule>

  <!-- EV-08. The CCN-CERT notification recorded in the register. -->
  <rule id="110804" level="3">
    <if_sid>110800</if_sid>
    <field name="event">ccn_cert_notification_recorded</field>
    <description>op.exp.7 · EV-08 · incidente $(incidente_id) notificado al CCN-CERT el $(notificacion_ccn_cert)</description>
  </rule>

  <!-- EV-12. The improvement measures recorded in the register. -->
  <rule id="110805" level="3">
    <if_sid>110800</if_sid>
    <field name="event">improvement_action_recorded</field>
    <description>op.exp.7 · EV-12 · incidente $(incidente_id): medidas de mejora registradas</description>
  </rule>

  <!-- ===== Log protection ===== -->

  <!-- EV-05. The alert log of a day spanning an incident: whether it is kept, the
       SHA-256 sealed by monitord at rotation, the one computed now over the content
       and whether the seal chain with the previous day matches. The engine decides
       whether they coincide. -->
  <rule id="110806" level="3">
    <if_sid>110800</if_sid>
    <field name="event">alert_log_seal_checked</field>
    <description>op.exp.7 · EV-05 · registro de alertas del $(dia): conservado $(conservado), sellado $(sellado)</description>
  </rule>

  <!-- ===== Active response ===== -->

  <!-- EV-06, EV-09 and EV-11. One active-response execution on a system, read from
       the `active_response` alerts that each agent's own log produces, with the
       command, the action and the rule that triggered it. -->
  <rule id="110807" level="5">
    <if_sid>110800</if_sid>
    <field name="event">active_response_executed</field>
    <description>op.exp.7 · EV-06 · respuesta activa $(comando) ($(accion)) en $(sistema) por la regla $(regla_disparadora)</description>
  </rule>

  <!-- EV-06, EV-09 and EV-11. One <active-response> block of the manager's
       ossec.conf: command, triggering rules, where it acts and whether it expires. -->
  <rule id="110808" level="3">
    <if_sid>110800</if_sid>
    <field name="event">active_response_configured</field>
    <description>op.exp.7 · EV-06 · respuesta activa configurada: $(comando) sobre $(reglas)</description>
  </rule>

  <!-- ===== Threat lists ===== -->

  <!-- EV-10. A CDB list declared in the manager's ossec.conf: whether it exists,
       when it was modified, how many entries it has and how many rules use it. -->
  <rule id="110809" level="3">
    <if_sid>110800</if_sid>
    <field name="event">threat_list_observed</field>
    <description>op.exp.7 · EV-10 · lista $(lista): $(entradas) entradas, modificada $(modificada)</description>
  </rule>

  <!-- ===== Degradation =====

       The collector issues no verdicts, but it must be able to say it could not
       look: `causa` separates «the source could not be read» from «it was read and
       held nothing»; the two are fixed in different places. -->
  <rule id="110895" level="7">
    <if_sid>110800</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.exp.7 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== Heartbeat and diagnostics ===== -->

  <!-- 110897. Proves no evidence: it ENABLES them. Declares which sources the run
       read and whether the incident register exists; without it, silence cannot
       count as compliance. -->
  <rule id="110897" level="3">
    <if_sid>110800</if_sid>
    <field name="event">collector_run</field>
    <description>op.exp.7 · pasada del recolector del manager: $(resultado)</description>
  </rule>

  <!-- 110898. Operational warning: a malformed register row, an unreadable local
       setting. Carries no requirement or evidence. -->
  <rule id="110898" level="4">
    <if_sid>110800</if_sid>
    <field name="event">collector_warning</field>
    <description>op.exp.7 · aviso del recolector: $(motivo)</description>
  </rule>

  <!-- 110899. A dependency (jq, python3) is missing and the run cannot proceed: no
       evidence is measured. -->
  <rule id="110899" level="7">
    <if_sid>110800</if_sid>
    <field name="event">collector_missing</field>
    <description>op.exp.7 · el recolector no puede correr: falta $(dependencia)</description>
  </rule>

</group>
