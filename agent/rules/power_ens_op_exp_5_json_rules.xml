<!-- CANONICAL SOURCE: plugin-wazuh-ens/agent/rules/power_ens_op_exp_5_json_rules.xml
     Deployable copy so the procedure works on a server without access to the
     plugin repository. Byte-identical in the Linux runbook, the LDAP runbook and
     the plugin: checked by plugin-wazuh-ens/tests/check-consistency.py. -->
<group name="power_ens,op_exp_5,score,">

  <!-- ================================================================
       op.exp.5 · Change management
       Reserved range: 110600-110699
       Base 110600 · raw facts 110601-110649 · degradation 110650 ·
       collector 110697-110699

       Fact -> rule ID -> evidence map (`relatedRules` in dashboard/ens/core/evidence/catalog.ts):

         110601 config_file_modified       EV-01, EV-02, EV-04, EV-07, EV-09
         110602 package_changed            EV-01, EV-02, EV-04, EV-07, EV-09
         110603 listening_port_changed     EV-01, EV-02, EV-04, EV-07
         110604 hardware_changed           EV-01, EV-02, EV-04, EV-07
         110605 change_register_read       EV-02, EV-03, EV-04, EV-06
         110606 change_request_registered  EV-02, EV-03, EV-04, EV-06
         110607 config_doc_modified        EV-06
         110608 service_failed             EV-07, EV-08
         110609 reversion_point_created    EV-09

       The first four are the machine's REAL CHANGES. The next two are the request
       register kept by the organization (/etc/power-ens/change-register.tsv), read
       as is: the agent does not correlate a change with its request, the engine does.
       EV-05 deliberately has no rule: proving the pre-production step requires
       crossing two machines and the engine evaluates each one separately.

       Outside the map: 110600 (base, level 0), 110650 (degradation: the agent says
       it could NOT look), 110697 (heartbeat: enables evidence, does not prove it),
       110698 (operational warning) and 110699 (gap between collector runs).
       No rule carries a compliance `estado` or `cumple`/`no_cumple` in its group:
       they are facts, and the plugin engine issues the verdict.
       ================================================================ -->

  <rule id="110600" level="0">
    <decoded_as>json</decoded_as>
    <field name="power_ens">op.exp.5</field>
    <description>op.exp.5 · evento Power ENS base</description>
  </rule>

  <!-- ===== Real changes ===== -->

  <!-- A write on a configuration path watched by auditd, with the session account
       that made it, the process and the interval (first and last write of the run).
       Read by PATH, not by key: if another control already watches the path, the
       kernel tags the event with its key. -->
  <rule id="110601" level="5">
    <if_sid>110600</if_sid>
    <field name="event">config_file_modified</field>
    <description>op.exp.5 · EV-01 · $(actor) modificó $(recurso) ($(operacion), $(primera))</description>
  </rule>

  <!-- An install, upgrade or removal transaction of software, with its actor and
       interval (same code as op.exp.4). -->
  <rule id="110602" level="5">
    <if_sid>110600</if_sid>
    <field name="event">package_changed</field>
    <description>op.exp.5 · EV-01 · $(actor) cambió software ($(mecanismo), $(inicio))</description>
  </rule>

  <!-- A listening port that appears or disappears between two runs. It is only known
       to have happened between `desde` and `detectado`, and travels that way. -->
  <rule id="110603" level="5">
    <if_sid>110600</if_sid>
    <field name="event">listening_port_changed</field>
    <description>op.exp.5 · EV-01 · puerto $(protocolo)/$(puerto) $(cambio) ($(proceso), detectado $(detectado))</description>
  </rule>

  <!-- A hardware component (CPU, memory, disk, network interface, PCI device) that
       appears or disappears between two runs. -->
  <rule id="110604" level="5">
    <if_sid>110600</if_sid>
    <field name="event">hardware_changed</field>
    <description>op.exp.5 · EV-01 · $(componente) $(cambio): $(elemento)</description>
  </rule>

  <!-- ===== The change request register ===== -->

  <!-- Header of a register read: how many requests it has, how many rows could not
       be read and its fingerprint. Without it the engine cannot know whether the
       rows that reached it are all of them. -->
  <rule id="110605" level="3">
    <if_sid>110600</if_sid>
    <field name="event">change_register_read</field>
    <description>op.exp.5 · EV-02 · registro de peticiones leído: $(filas) peticiones ($(registro))</description>
  </rule>

  <!-- A register request, with its fourteen columns as the organization wrote them. -->
  <rule id="110606" level="3">
    <if_sid>110600</if_sid>
    <field name="event">change_request_registered</field>
    <description>op.exp.5 · EV-02 · petición $(peticion_id) ($(estado), riesgo $(riesgo)) para $(sistema)</description>
  </rule>

  <!-- ===== Documentation, stability and reversion ===== -->

  <!-- A configuration document (P-06) watched on the machine and the instant of its
       last modification. -->
  <rule id="110607" level="3">
    <if_sid>110600</if_sid>
    <field name="event">config_doc_modified</field>
    <description>op.exp.5 · EV-06 · $(ruta) modificado $(modificado)</description>
  </rule>

  <!-- A service that is down in this run, with the instant it went down. STATE fact:
       re-emitted whole on every run. Read by EV-07 (did it fail because of a change?)
       and EV-08 (failure to be communicated). -->
  <rule id="110608" level="7">
    <if_sid>110600</if_sid>
    <field name="event">service_failed</field>
    <description>op.exp.5 · EV-07 · $(unidad) caído desde $(desde)</description>
  </rule>

  <!-- A local reversion point observed (LVM, ZFS or Btrfs snapshot) with its creation
       instant (same code as op.exp.4). -->
  <rule id="110609" level="3">
    <if_sid>110600</if_sid>
    <field name="event">reversion_point_created</field>
    <description>op.exp.5 · EV-09 · punto de reversión $(mecanismo) $(identificador) ($(creado))</description>
  </rule>

  <!-- ===== Degradation =====
       The `causa` distinguishes «the source could not be read» from «it was read
       and nothing was found»; they are fixed in different places. -->
  <rule id="110650" level="5">
    <if_sid>110600</if_sid>
    <field name="event">evidence_state</field>
    <field name="estado">NO_EVALUABLE</field>
    <description>op.exp.5 · $(evidence_id) no se ha podido medir ($(causa)): $(motivo)</description>
  </rule>

  <!-- ===== Collector ===== -->

  <!-- 110697. Heartbeat. Proves no evidence: it ENABLES it. Without it, a period with
       no changes cannot count as compliance. -->
  <rule id="110697" level="3">
    <if_sid>110600</if_sid>
    <field name="event">collector_run</field>
    <description>op.exp.5 · pasada del recolector: $(resultado)</description>
  </rule>

  <!-- 110698. Operational warning: unreadable .env, collector without root, declared
       document that does not exist. Pipeline hygiene. -->
  <rule id="110698" level="5">
    <if_sid>110600</if_sid>
    <field name="event">collector_warning</field>
    <description>op.exp.5 · aviso del recolector ($(parametro)): $(motivo)</description>
  </rule>

  <!-- 110699. The collector was stopped longer than its cron allows: during that span
       there may have been changes the audit log no longer keeps. -->
  <rule id="110699" level="7">
    <if_sid>110600</if_sid>
    <field name="event">collector_missing</field>
    <description>op.exp.5 · hueco en las pasadas del recolector: $(detalle)</description>
  </rule>

</group>
